---
import Marquesina from '../components/superior.astro';
import Bolas from '../components/bolas.astro';

interface Props {
    title?: string;
    showSplash?: boolean;
    showLogo?: boolean;
    showBolas?: boolean;
    /* true = esta página controla su propio 100vh/100vw (scroll-jacking, vídeo, GSAP...).
       false (por defecto) = contenido de tamaño fijo, escalado como el lienzo de la home. */
    pantallaCompleta?: boolean;
}

const {
    title = "Leyre Serafina Gutiérrez Cruz",
    showSplash = false,
    showLogo = true,
    showBolas = false,
    pantallaCompleta = false,
} = Astro.props;
const añoActual = new Date().getFullYear();

// ── ÚNICO LUGAR DEL PROYECTO donde se define el tamaño de referencia ──
// Mide tu ventana en el portátil (consola: innerWidth + 'x' + innerHeight)
// y pon esos dos números aquí. No se tocan en ningún otro sitio.
const DISENO_ANCHO = 1920;
const DISENO_ALTO = 1080;
---

<html lang="en">
    <head>
        <meta name="google-site-verification" content="xxw6J3WwUNNQkjpqp0UzYc54TAQNxUHluMyfgVQWj9E" />
        <meta charset="utf-8" />
        <link rel="icon" href="/favicon2.ico" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="ִֶָ𓂃 ࣪˖ ִֶָ🫑་༘࿐ Leyre Serafina Web" />
        <title>{title}</title>

        <script is:inline>
            if (sessionStorage.getItem('splashVisto') === 'true') {
                document.documentElement.classList.add('sin-splash');
            }
        </script>

        <style is:global>
            /* Regla 2: rem fijo de verdad, no depende de ajustes de accesibilidad del navegador */
            html {
                font-size: 16px;
                height: 100%;
            }

            /* Regla 3: box-sizing consistente en todo */
            *, *::before, *::after {
                box-sizing: border-box;
            }

            .sin-splash #splash-screen {
                display: none !important;
            }

            body {
                background-color: #faf9f5;
                margin: 0;
                font-family: 'AMANO', sans-serif;
                min-height: 100vh;
                cursor: url('/gifglitter.gif'), auto !important;
            }
/* Solo las páginas con lienzo escalado bloquean el scroll (son de una sola pantalla).
               Las pantallaCompleta necesitan scroll real para GSAP ScrollTrigger. */
            body.lienzo-activo {
                overflow: hidden;
            }

            a, button, .splash-grupo, .logo-inicio-flotante {
                cursor: url('/gifglitter.gif'), pointer !important;
            }

            /* ── EL LIENZO ──
               Tamaño fijo = tu diseño de portátil, sin excepciones.
               Se centra y se escala entero con un solo transform (ver script al final).
               Todo lo que va DENTRO usa únicamente px/rem fijos — nunca vw/vh/%. */
            #lienzo {
                width: calc(var(--diseno-ancho) * 1px);
                height: calc(var(--diseno-alto) * 1px);
                position: fixed;
                top: 50%;
                left: 50%;
                transform-origin: center center;
                display: flex;
                flex-direction: column;
            }

            main {
                flex: 1;
                min-height: 0;
                padding-top: 24px; /* reserva el hueco de la marquesina, que vive fuera del lienzo */
            }

            /* Cuando la página es pantallaCompleta, main no vive dentro del lienzo:
               ocupa el viewport real directamente (para scroll-jacking, vídeo, GSAP...). */
            main.pantalla-completa {
                width: 100vw;
                min-height: 100vh;
                padding-top: 0;
                overflow: visible;
            }

            /* ── FUERA DEL LIENZO: chrome de pantalla completa, deliberadamente sin escalar ── */
           #splash-screen {
                position: fixed;
                top: 0; left: 0; width: 100vw; height: 100vh;
                background: white url('/image.avif') no-repeat center center; 
                background-size: cover;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                align-items: center;
                z-index: 99999;
                cursor: url('/gifglitter.gif'), pointer !important;
                transition: opacity 0.4s ease;
                padding: 2rem;
            }

            .splash-centro {
                display: flex;
                flex: 1;
                justify-content: center;
                align-items: center;
                width: 100%;
            }

            .splash-grupo {
                display: flex;
                align-items: center;
                gap: 4rem;
                text-decoration: none;
                transition: opacity 0.2s ease;
            }

            .splash-grupo:hover {
                opacity: 0.6;
            }

            .splash-nombre, .splash-bicho {
                height: auto;
                filter: drop-shadow(0px 0px 0.6px #000) drop-shadow(0px 0px 0.6px #000);
                display: block;
            }

            .splash-nombre {
                width: 380px; 
            }

            .splash-bicho {
                width: 250px; 
            }

            #splash-screen img {
                max-width: 100% !important;
            }

            @font-face {
                font-family: 'AMANO'; 
                src: url('/fonts/AlteHaasGroteskBold.ttf') format('opentype'); 
                font-weight: normal;
                font-style: normal;
                font-display: swap;
            }

            .fade-out {
                opacity: 0;
                pointer-events: none;
            }

            .logo-inicio-flotante {
                position: fixed;
                top: 5%;
                left: 50%;
                transform: translateX(-50%);
                z-index: 999;
                text-decoration: none;
                transition: opacity 0.2s ease;
            }
            .logo-inicio-flotante:hover {
                opacity: 0.6;
            }

            .logo-inicio-flotante img {
                width: clamp(80px, 6vw, 160px);
                height: auto;
                filter: drop-shadow(0px 0px 0.6px #3300ff) drop-shadow(0px 0px 0.6px #000);
            }

            .franja-nombre-azul {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 1rem 2rem;
                background-color: #45ffa2;
                color: #ff6ab4;
                text-decoration: none;
                transition: background-color 0.2s ease;
            } 

            .franja-nombre-azul:hover {
                background-color: #74aeff;
            }

            .titulo-nombre-azul {
                font-size: 1.4rem;
                margin: 0;
                letter-spacing: 1px;
            }

            .footer-contenedor {
                display: flex;
                justify-content: space-between;
                align-items: center;
                width: 100%;
                padding: 1rem 2rem;
                background-color: transparent;
                margin-top: auto; 
                position: relative;
                z-index: 9999;
                font-size: 0.3rem;
                color: #666;
                letter-spacing: 1px;
            }

            .footer-copyright {
                position: absolute;
                left: 50%;
                transform: translateX(-50%);
                text-align: center;
                font-size: 0.50rem;
            }
        </style>
    </head>

    <body class={pantallaCompleta ? '' : 'lienzo-activo'}>
        {showSplash && (
            <div id="splash-screen">
                <div></div>
                <div class="splash-centro">
                    <a href="/" class="splash-grupo" aria-label="Volver al inicio">
                        <img src="/nombre.png" alt="Leyre Serafina Gutiérrez Cruz" class="splash-nombre" />
                        <img src="/v2.svg" alt="Logo Bicho" class="splash-bicho" />
                    </a>
                </div>
            </div>
        )}

        <Marquesina />

        {showLogo && (
            <a href="/" class="logo-inicio-flotante" aria-label="Volver al inicio">
                <img src="/v2.svg" alt="Logo Inicio" />
            </a>
        )}

        {showBolas && <Bolas />}

        {pantallaCompleta ? (
            <main class="pantalla-completa">
                <slot />
            </main>
        ) : (
            <div id="lienzo" style={`--diseno-ancho:${DISENO_ANCHO}; --diseno-alto:${DISENO_ALTO};`}>
                <main>
                    <slot />
                </main>

                <div class="footer-contenedor">
                    <div class="footer-copyright">
                        © {añoActual}, LEYRE SERAFINA GUTIERREZ CRUZ
                    </div>
                </div>
            </div>
        )}

        <script>
            const splash = document.getElementById('splash-screen');

            if (splash) {
                if (sessionStorage.getItem('splashVisto') === 'true') {
                    splash.remove();
                } else {
                    splash.addEventListener('click', (e) => {
                        splash.classList.add('fade-out');
                        sessionStorage.setItem('splashVisto', 'true');
                        setTimeout(() => splash.remove(), 400);
                    });
                }
            }
        </script>

        <script is:inline>
            // Regla 1: este es el ÚNICO sitio de todo el proyecto que puede
            // mirar el tamaño real de la pantalla. Todo lo demás son px/rem fijos.
            const lienzo = document.getElementById('lienzo');

            if (lienzo) {
                const disenoAncho = parseFloat(getComputedStyle(lienzo).getPropertyValue('--diseno-ancho'));
                const disenoAlto = parseFloat(getComputedStyle(lienzo).getPropertyValue('--diseno-alto'));

                function ajustarEscala() {
                    const escalaX = window.innerWidth / disenoAncho;
                    const escalaY = window.innerHeight / disenoAlto;
                    const escala = Math.max(escalaX, escalaY); // "cover": llena siempre, recorta si sobra

                    lienzo.style.transform = `translate(-50%, -50%) scale(${escala})`;
                }

                ajustarEscala();
                window.addEventListener('resize', ajustarEscala);
            }
        </script>
    </body>
</html>