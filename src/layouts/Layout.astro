---
interface Props {
    title?: string;
    showSplash?: boolean;
}

const { title = "Leyre Serafina Gutiérrez Cruz", showSplash = false } = Astro.props;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content="ִֶָ𓂃 ࣪˖ ִֶָ🫑་༘࿐" />
        <title>{title}</title>

        <!-- Script inline ultrarrápido para eliminar el splash ANTES de que se pinte en pantalla si ya se vio -->
        <script is:inline>
            if (sessionStorage.getItem('splashVisto') === 'true') {
                document.documentElement.classList.add('sin-splash');
            }
        </script>

        <style is:global>
            /* Si ya se vio el splash, ocultamos el contenedor desde el primer milisegundo para cero parpadeos */
            .sin-splash #splash-screen {
                display: none !important;
            }

            body {
                background-color: rgb(255, 255, 255);
                margin: 0;
                font-family: 'AMANO', sans-serif;
                display: flex;
                flex-direction: column;
                min-height: 100vh;
                box-sizing: border-box;
            }

            html {
                height: 100%;
            }

            #splash-screen {
                position: fixed;
                top: 0; left: 0; width: 100vw; height: 100vh;
                background: white url('/fondo_pared.jpg') no-repeat center center fixed; 
                background-size: cover;
                display: flex;
                justify-content: center;
                align-items: center;
                z-index: 99999;
                cursor: pointer;
                transition: opacity 0.4s ease;
            }

            @font-face {
                font-family: 'AMANO'; 
                src: url('/fonts/MyUglyHandwriting-Regular.otf') format('opentype'); 
                font-weight: normal;
                font-style: normal;
                font-display: swap;
            }

            .fade-out {
                opacity: 0;
                pointer-events: none;
            }

            /* Marquesina roja fina arriba del todo */
            .marquesina-superior {
                overflow: hidden;
                white-space: nowrap;
                background-color: #ff67a9;
                color: #ffffff;
                font-size: 0.8rem;
                height: 24px;
                line-height: 24px;
                width: 100%;
                box-sizing: border-box;
                position: fixed;
                top: 0;
                z-index: 1000;
            }

            .marquesina-track {
                display: inline-block;
                animation: moverTexto 18s linear infinite;
            }

            .marquesina-track span {
                display: inline-block;
                padding-right: 3rem;
            }

            @keyframes moverTexto {
                0% { transform: translateX(0); }
                100% { transform: translateX(-50%); }
            }

            /* Logo central superior como botón de inicio */
            .logo-inicio-flotante {
                position: fixed;
                top: 32px;
                left: 50%;
                transform: translateX(-50%);
                z-index: 999;
                text-decoration: none;
                transition: opacity 0.2s ease;
            }

            .logo-inicio-flotante:hover {
                opacity: 0.6;
            }

            .logo-inicio-flotante img {
                width: 105px; 
                height: auto;
                filter: drop-shadow(0px 0px 0.6px #000) drop-shadow(0px 0px 0.6px #000);
            }

            /* Franja azul con tu nombre */
            .franja-nombre-azul {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 1rem 2rem;
                background-color: #458fff;
                color: #ffffff;
                text-decoration: none;
                border-bottom: 3px solid #faf9f5;
                transition: background-color 0.2s ease;
            }   

            .franja-nombre-azul:hover {
                background-color: #74aeff;
            }

            .titulo-nombre-azul {
                font-size: 1.4rem;
                margin: 0;
                letter-spacing: 1px;
            }

            .etiqueta-info-azul {
                font-size: 0.9rem;
                letter-spacing: 0.5px;
            }

            .obras-franjas-container {
                display: flex;
                flex-direction: column;
                width: 100%;
                margin-top: 135px; 
            }

            /* Franjas de las obras */
            .franja-obra {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0.5rem 1rem;  
                background-color: #ffe65d; 
                border-bottom: 20px solid #faf9f5; 
                text-decoration: none;
                transition: background-color 0.2s ease;
            }

            .franja-obra:hover {
                 background-color: #fff695;
            }
            
            .titulo-obra {
                font-size: 3rem;
                font-weight: 900;
                color: #d2384a; 
                text-transform: uppercase;
                margin: 0;
                margin-left: 2rem;        
                text-align: right;        
                letter-spacing: 1px;
                transition: font-weight 0.1s ease; 
            }

            .franja-obra:hover .titulo-obra {
                font-weight: 1000;
            }

            /* Contenedor principal que ocupa el espacio y empuja el footer abajo */
            main {
                flex: 1;
            }

            /* Estilo para el texto de copyright al final */
            .footer-copyright {
                text-align: center;
                font-size: 0.9rem;
                color: #666;
                padding: 1.5rem 0;
                letter-spacing: 1px;
                background-color: transparent;
                width: 100%;
                margin-top: auto; 
                position: relative;
                z-index: 9999;
            }

            body::after {
                content: "";
                position: fixed;
                top: 24px;
                left: 0;
                width: 100vw;
                height: calc(100vh - 24px);
                background-image: url('/6566712.jpg');
                background-repeat: repeat; 
                background-size: 300px; 
                opacity: 0.8; 
                pointer-events: none; 
                mix-blend-mode: overlay;
                z-index: 9998; 
            }
        </style>
    </head>

    <body>
        {showSplash && (
            <div id="splash-screen">
                <img src="/v2.svg" alt="Logo" style="max-width: 600px; filter: drop-shadow(0px 0px 0.6px #000) drop-shadow(0px 0px 0.6px #000);" />
            </div>
        )}

        <div class="marquesina-superior">
            <div class="marquesina-track">
                <span>✧ ARTISTA VISUAL & ESCULTORA ✧ NUEVOS PROYECTOS 2026 ✧ DISPONIBLE PARA COLABORACIONES ✧ </span>
                <span>✧ ARTISTA VISUAL & ESCULTORA ✧ NUEVOS PROYECTOS 2026 ✧ DISPONIBLE PARA COLABORACIONES ✧ </span>
            </div>
        </div>

        <a href="/" class="logo-inicio-flotante" aria-label="Volver al inicio">
            <img src="/v2.svg" alt="Logo Inicio" />
        </a>

        <main>
            <slot />
        </main>

        <div class="footer-copyright">
            © 2O26, LEYRE SERAFINA GUTIERREZ CRUZ
        </div>

        <script>
            const splash = document.getElementById('splash-screen');
            
            if (splash) {
                if (sessionStorage.getItem('splashVisto') === 'true') {
                    splash.remove();
                } else {
                    splash.addEventListener('click', () => {
                        splash.classList.add('fade-out');
                        sessionStorage.setItem('splashVisto', 'true');
                        setTimeout(() => splash.remove(), 400);
                    });
                }
            }
        </script>
    </body>
</html>