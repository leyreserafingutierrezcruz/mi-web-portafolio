    </div>
</div>

<script>
    const track = document.getElementById('superiorSub');
    const spanOriginal = track?.querySelector('.texto-base') as HTMLElement;

    if (track && spanOriginal) {
        const anchoPantalla = window.innerWidth;
        const anchoSpan = spanOriginal.offsetWidth;
        const vecesADuplicar = Math.ceil((anchoPantalla * 3) / anchoSpan);

        for (let i = 0; i < vecesADuplicar; i++) {
            const clone = spanOriginal.cloneNode(true);
            track.appendChild(clone);
        }
    }
</script>

<style>
    .sub-superior {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        /* antes: height fija de 24px.
           ahora: escala entre 16px (portátil pequeño) y 24px (monitor grande),
           con un punto intermedio fluido basado en el ancho de la ventana */
        height: clamp(10px, 1.1vw, 16px);
        background-color: #505050;
        overflow: hidden;
        z-index: 9999;
        cursor: url('/gifglitter.gif'), pointer !important;
    }

    .sub-track {
        display: flex;
        width: max-content;
        white-space: nowrap;
        animation: moverSub 60s linear infinite;
        will-change: transform;
    }

    .sub-superior:hover .sub-track {
        animation-play-state: paused !important;
    }

    @keyframes arcoiris-texto {
        0% { filter: hue-rotate(0deg); }
        100% { filter: hue-rotate(360deg); }
    }

    .sub-track span {
        font-family: inherit;
        /* antes: 12px fijo. ahora escala junto con la barra */
        font-size:clamp(6px, 0.6vw, 9px);
        background: linear-gradient(to right, red, orange, yellow, rgb(91, 191, 91), cyan, blue, violet);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: arcoiris-texto 6s linear infinite;
        /* antes: line-height fijo de 24px, ahora sigue a la altura de la barra */
        line-height: clamp(10px, 1.1vw, 16px);
        display: inline-block;
    }

    @keyframes moverSub {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(-50%);
        }
    }
</style>