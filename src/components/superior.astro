---
// src/components/Marquesina.astro

const ahora = new Date();

const fechaFormateada = ahora.toLocaleDateString('es-ES', {
    timeZone: 'Europe/Madrid',
    day: 'numeric',
    month: 'long',
    year: 'numeric'
});

const inicioAnio = new Date(ahora.getFullYear(), 0, 1);
const diferenciaDias = Math.floor((ahora.getTime() - inicioAnio.getTime()) / (1000 * 60 * 60 * 24)) + 1;

// ── AQUÍ SE CONFIGURA PARA 4 DÍGITOS (SOLO HORA Y MINUTOS) ──
const horaMadridInicial = ahora.toLocaleTimeString('es-ES', {
    timeZone: 'Europe/Madrid',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false
});
---

<div class="sub-superior">
    <div class="sub-track" id="superiorSub">
        <span class="texto-base">
            ⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀
            ⠀⠀⠀⠀Hoy y por el momento, solo hoy es...
            <!--{fechaFormateada} !!, andamos a día {diferenciaDias} del año. Tome hora son las <span class="reloj-marquesina">{horaMadridInicial}</span> (MAD) ⠀&nbsp;&nbsp;&nbsp;&nbsp; -->
        </span>
    </div>
</div>

<script>
    const track = document.getElementById('superiorSub');
    const spanOriginal = track?.querySelector('.texto-base') as HTMLElement;

    if (track && spanOriginal) {
        const anchoPantalla = window.innerWidth;
        const anchoSpan = spanOriginal.offsetWidth;
        const vecesADuplicar = Math.ceil((anchoPantalla * 3) / anchoSpan);

        for (let i = 0; i < vecesADuplicar; i++) {
            const clone = spanOriginal.cloneNode(true);
            track.appendChild(clone);
        }
    }

    // Actualizamos en bucle manteniendo los 4 dígitos (sin segundos)
    setInterval(() => {
        const ahoraLocal = new Date();
        const horaActualizada = ahoraLocal.toLocaleTimeString('es-ES', {
            timeZone: 'Europe/Madrid',
            hour: '2-digit',
            minute: '2-digit',
            hour12: false
        });

        const relojes = document.querySelectorAll('.reloj-marquesina');
        relojes.forEach(el => {
            el.textContent = horaActualizada;
        });
    }, 1000);
</script>

<style>
    .sub-superior {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: clamp(10px, 1.1vw, 16px);
        background-color: #fafafa;
        overflow: hidden;
        z-index: 9999;
        cursor: url('/gifglitter.gif'), pointer !important;
    }

    .sub-track {
        display: flex;
        width: max-content;
        white-space: nowrap;
        animation: moverSub 60s linear infinite;
        will-change: transform;
    }

    .sub-superior:hover .sub-track {
        animation-play-state: paused !important;
    }

    @keyframes arcoiris-texto {
        0% { filter: hue-rotate(0deg); }
        100% { filter: hue-rotate(360deg); }
    }

    .sub-track span.texto-base {
        font-family: inherit;
        font-size: clamp(6px, 0.6vw, 9px);
        background: rgb(2, 30, 14);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
       
        line-height: clamp(10px, 1.1vw, 16px);
        display: inline-block;
    }

    .sub-track span span {
        font-family: inherit;
        font-size: inherit;
        background: inherit;
        -webkit-background-clip: inherit;
        -webkit-text-fill-color: inherit;
        animation: inherit;
    }

    @keyframes moverSub {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(-50%);
        }
    }
</style>