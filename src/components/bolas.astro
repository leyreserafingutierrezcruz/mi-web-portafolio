<div class="canvas-container">
  <canvas id="bolasCanvas"></canvas>
</div>

<script>
  const canvas = document.getElementById('bolasCanvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d');

  // --- SOPORTE DE ALTA DEFINICIÓN (NITIDEZ) ---
  const dpr = window.devicePixelRatio || 1;
  let width = window.innerWidth;
  let height = window.innerHeight;

  function resizeCanvas() {
    width = window.innerWidth;
    height = window.innerHeight;
    canvas.width = width * dpr;
    canvas.height = height * dpr;
    canvas.style.width = `${width}px`;
    canvas.style.height = `${height}px`;
    if (ctx) ctx.scale(dpr, dpr);
    initParticles();
  }

  window.addEventListener('resize', resizeCanvas);

  // --- CONFIGURACIÓN DE TAMAÑO Y MOVIMIENTO ---
  const mouse = { x: -1000, y: -1000, radius: 150 }; 
  const particleConfig = {
    size: 1.7, // Tu tamaño preferido
    density: 13
  };
  // -------------------------------------------

  // Escuchamos el ratón a nivel global para que funcione aunque el canvas sea transparente a los clics
  window.addEventListener('mousemove', (e) => {
    mouse.x = e.clientX;
    mouse.y = e.clientY;
  });

  window.addEventListener('mouseleave', () => {
    mouse.x = -1000;
    mouse.y = -1000;
  });

  class Particle {
    x: number;
    y: number;
    baseX: number;
    baseY: number;
    size: number;
    density: number;

    constructor(x: number, y: number) {
      this.x = x;
      this.y = y;
      this.baseX = x;
      this.baseY = y;
      this.size = particleConfig.size; 
      this.density = Math.random() * particleConfig.density + 1; 
    }

    draw() {
      if (!ctx) return;
      ctx.fillStyle = '#0df7ff'; // Tu color exacto
      ctx.beginPath();
      ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
      ctx.closePath();
      ctx.fill();
    }

    update() {
      let dx = mouse.x - this.x;
      let dy = mouse.y - this.y;
      let distance = Math.sqrt(dx * dx + dy * dy);
      let forceDirectionX = dx / distance;
      let forceDirectionY = dy / distance;

      let maxDistance = mouse.radius;
      let force = (maxDistance - distance) / maxDistance;
      let directionX = forceDirectionX * force * this.density;
      let directionY = forceDirectionY * force * this.density;

      if (distance < mouse.radius) {
        this.x -= directionX;
        this.y -= directionY;
      } else {
        if (this.x !== this.baseX) {
          let dx = this.x - this.baseX;
          this.x -= dx / 10;
        }
        if (this.y !== this.baseY) {
          let dy = this.y - this.baseY;
          this.y -= dy / 10;
        }
      }
    }
  }

  let particlesArray: Particle[] = [];

  function initParticles() {
    particlesArray = [];
    let gap = 22; // Espaciado entre bolitas
    for (let y = 0; y < height; y += gap) {
      for (let x = 0; x < width; x += gap) {
        particlesArray.push(new Particle(x, y));
      }
    }
  }

  function animate() {
    if (!ctx) return;
    ctx.clearRect(0, 0, width, height);
    for (let i = 0; i < particlesArray.length; i++) {
      particlesArray[i].draw();
      particlesArray[i].update();
    }
    requestAnimationFrame(animate);
  }

  resizeCanvas();
  animate();
</script>

<style>
  .canvas-container {
    position: fixed;
    top: 24px;
    left: 0;
    width: 100vw;
    height: calc(100vh - 24px);
    z-index: 9999; /* Flota por encima de todo */
    pointer-events: none; /* CLAVE: El ratón atraviesa el canvas para hacer clic en los botones de abajo */
  }
  #bolasCanvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>