---
import Layout from '../layouts/maestra.astro';
---

<Layout title="CURRÍCULUM — Leyre Serafina Gutiérrez Cruz" pantallaCompleta={true}>
    
    <div class="rastros-container" id="rastros-container"></div>

    <main class="contenido-cv">
        <div class="contenedor-ascii-cv">
            <pre class="arte-ascii">
    .-.       _______                    .  '  * .  . '
   ()``; |==|_______D                    .  * * -+-
   /  ('         /|\                    .    * .    '  *
 (  /   |         / | \                    * .  ' .  .
 \(__)_]]       /  |  \                  * * .   .
                                            '   *
------------------------------------------------
            </pre>
        </div>
    </main>

</Layout>

<script>
    const container = document.getElementById('rastros-container');

    if (container) {
        window.addEventListener('mousemove', (e) => {
            const rastro = document.createElement('div');
            rastro.className = 'punto-rastro';
            
            // Usamos pageX/pageY o clientX directos para máxima precisión en fixed
            rastro.style.left = `${e.clientX}px`;
            rastro.style.top = `${e.clientY}px`;
            
            container.appendChild(rastro);

            setTimeout(() => {
                rastro.style.opacity = '0';
                setTimeout(() => {
                    rastro.remove();
                }, 300);
            }, 800);
        });
    }
</script>

<style>
    /* Forzamos que la página de este layout no tenga márgenes raros */
    :global(html, body) {
        margin: 0;
        padding: 0;
        overflow-x: hidden;
        width: 100%;
        background-color: #ffffff;
    }

    .rastros-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        pointer-events: none;
        z-index: 999; /* Por debajo del contenido principal pero cubriendo toda la pantalla */
    }

    :global(.punto-rastro) {
        position: fixed; /* Cambiado a fixed para que respete el scroll de la ventana sin desviarse */
        width: 100px;
        height: 100px;
        transform: translate(-50%, -50%);
        pointer-events: none;
        border-radius: 50%; 
        background: radial-gradient(
            circle,
            rgba(255, 0, 217, 0.35),
            rgba(255, 215, 0, 0.2),
            rgba(70, 255, 218, 0.1),
            transparent 70%
        );
        transition: opacity 0.3s ease-out;
        opacity: 1;
    }

    .contenido-cv {
        position: relative;
        z-index: 1000; /* Asegura que el texto esté siempre accesible y por encima */
        margin-top: 150px;
        padding: 2rem;
        box-sizing: border-box;
        width: 100%;
        min-height: calc(100vh - 150px);
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .contenedor-ascii-cv {
        margin-bottom: 2rem;
    }

    .arte-ascii {
        font-family: monospace;
        font-size: 1.2vw;
        line-height: 1.1;
        color: #111111;
        margin: 0;
        white-space: pre;
    }

    @media (max-width: 768px) {
        .arte-ascii {
            font-size: 2.5vw;
        }
    }
</style>