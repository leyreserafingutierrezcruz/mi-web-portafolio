---
import Layout from '../layouts/maestra.astro';
---

<Layout title="CURRÍCULUM — Leyre Serafina Gutiérrez Cruz">
    
    <!-- Contenedor donde aparecerán las estelas del ratón -->
    <div class="rastros-container" id="rastros-container"></div>


</Layout>

<script>
    const container = document.getElementById('rastros-container');

    if (container) {
        window.addEventListener('mousemove', (e) => {
            const rastro = document.createElement('div');
            rastro.className = 'punto-rastro';
            
            rastro.style.left = `${e.clientX}px`;
            rastro.style.top = `${e.clientY}px`;
            
            container.appendChild(rastro);

            setTimeout(() => {
                rastro.style.opacity = '0';
                setTimeout(() => {
                    rastro.remove();
                }, 300);
            },1000);
        });
    }
</script>

<style>
    :global(html, body) {
        margin: 0;
        padding: 0;
        overflow-x: hidden;
        max-width: 100vw;
        background-color: #ffffff;
    }

    .rastros-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        pointer-events: none;
        z-index: 1;
    }

    :global(.punto-rastro) {
        position: absolute;
        width: 120px;
        height: 120px;
        transform: translate(-50%, -50%);
        pointer-events: none;
        border-radius: 50%;
        background: radial-gradient(
            circle,
            rgba(255, 0, 217, 0.4),
            rgba(255, 215, 0, 0.25),
            rgba(70, 255, 218, 0.168),
            transparent 70%
        );
        transition: opacity 0.3s ease-out;
        opacity: 1;
    }

    .contenido-cv {
        position: relative;
        z-index: 2;
        margin-top: 130px;
        padding: 2rem;
        box-sizing: border-box;
        width: 100%;
        min-height: calc(100vh - 130px);
    }
</style>