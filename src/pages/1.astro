---
import Layout from '../layouts/maestra.astro';
---

<Layout title="la otra altura del suelo — Leyre Serafina Gutiérrez Cruz">
    <!-- Filtro SVG oculto que genera la deformación matemática de lente -->
    <svg style="position: absolute; width: 0; height: 0; pointer-events: none;" aria-hidden="true">
        <filter id="lupa-fisheye" x="0%" y="0%" width="100%" height="100%">
            <feImage id="mapa-desplazamiento" preserveAspectRatio="none" result="map" href="" />
            <feDisplacementMap in="SourceGraphic" in2="map" scale="80" xChannelSelector="R" yChannelSelector="G" />
        </filter>
    </svg>

    <div class="pantalla-completa">
        <div class="contenedor-imagenes">
            <div class="contenedor-efecto img-izquierda">
                <img src="/edit_city2.avif" alt="izquierda" class="img-obra img-izquierda-style" />
                <div class="destello-espejo mask-izq"></div>
            </div>
            <div class="contenedor-efecto img-centro">
                <img src="/edit_city.avif" alt="centro" class="img-obra img-centro-style" />
                <div class="destello-espejo mask-cen flip-horizontal"></div>
            </div>
            <div class="contenedor-efecto img-derecha">
                <img src="/edit_city.avif" alt="derecha" class="img-obra img-derecha-style" />
                <div class="destello-espejo mask-der"></div>
            </div>
        </div>
    </div>
</Layout>

<style>
    :global(html), :global(body) {
        overflow: hidden !important;
        height: 100vh !important;
        width: 100vw !important;
        margin: 0;
    }

    :global(body) {
        background-image: 
            linear-gradient(rgba(255, 255, 255, 0.3), rgba(255, 255, 255, 0.3)), 
            url('/metal.avif') !important;
        background-size: cover !important;
        background-position: center !important;
        background-repeat: no-repeat !important;
    }

    .pantalla-completa {
        position: relative;
        width: 100vw;
        height: calc(100vh - 120px);
        display: flex;
        justify-content: center;
        align-items: center;
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        top: 90px; 
    }

    .contenedor-imagenes {
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;
        width: 100%;
        height: 100vw; 
        margin-left: -20vw; 
        gap: 1vw; 
    }

    .contenedor-efecto {
        position: relative;
        display: inline-block;
        cursor: crosshair;
    }

    .img-obra {
        width: auto;
        object-fit: contain;
        display: block;
        transition: filter 0.1s ease;
    }

    .contenedor-efecto.activo .img-obra {
        filter: url(#lupa-fisheye) grayscale(100%) brightness(1.1);
    }
    .contenedor-efecto.activo.img-centro .img-obra {
        filter: url(#lupa-fisheye) grayscale(100%) brightness(1.05);
        transform: scaleX(-1);
    }

    .destello-espejo {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        opacity: 0;
        z-index: 10;
        
        background: linear-gradient(
            to bottom,
            transparent 0%,
            rgba(255, 0, 90, 0.2) 30%,
            rgba(255, 230, 0, 0.6) 45%,
            rgba(255, 255, 255, 0.95) 50%,
            rgba(0, 230, 255, 0.6) 55%,
            rgba(150, 0, 255, 0.4) 70%,
            transparent 100%
        );
        
        background-size: 100% 300%;
        background-position: center -100%;
        
        mix-blend-mode: color-dodge;
        
        -webkit-mask-size: contain;
        mask-size: contain;
        -webkit-mask-repeat: no-repeat;
        mask-repeat: no-repeat;
        -webkit-mask-position: center;
        mask-position: center;
    }

    .flip-horizontal {
        transform: scaleX(-1);
    }

    .mask-izq {
        -webkit-mask-image: url('/edit_city2.avif');
        mask-image: url('/edit_city2.avif');
    }
    .mask-cen, .mask-der {
        -webkit-mask-image: url('/edit_city.avif');
        mask-image: url('/edit_city.avif');
    }

    @keyframes barridoVertical {
        0% {
            background-position: center -150%;
            opacity: 0;
        }
        20% {
            opacity: 1;
        }
        80% {
            opacity: 1;
        }
        100% {
            background-position: center 250%;
            opacity: 0;
        }
    }

    .contenedor-efecto:hover .destello-espejo {
        animation: barridoVertical 1.2s ease-in-out forwards;
    }

    .img-derecha {
        max-height: 82vh; 
        transform: translateY(3px); 
        z-index: 1;
    }
    .img-derecha-style {
        max-height: 82vh;
    }

    .img-centro {
        max-height: 72vh; 
        z-index: 2;
    }
    .img-centro-style {
        max-height: 72vh;
        transform: scaleX(-1) translateY(0px); 
        filter: grayscale(100%) brightness(1.05); 
    }

    .img-izquierda {
        max-height: 68vh; 
        z-index: 3;
    }
    .img-izquierda-style {
        max-height: 68vh;
        transform: translateY(0px); 
        filter: grayscale(100%) brightness(1.15); 
    }

    @media (max-width: 768px) {
        .pantalla-completa {
            height: calc(100vh - 100px);
            padding: 1rem;
            overflow-y: auto;
            top: 0;
        }
        .contenedor-imagenes {
            flex-direction: column;
            gap: 1rem;
            height: auto;
            margin-left: 0;
        }
        .contenedor-efecto {
            max-height: 35vh !important;
            transform: none !important;
        }
    }
</style>

<script>
    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d');
    const mapElement = document.getElementById('mapa-desplazamiento') as unknown as SVGElement;

    function generarMapaLupa(px: number, py: number, ancho: number, alto: number) {
        canvas.width = ancho;
        canvas.height = alto;
        if (!ctx) return;

        const imgData = ctx.createImageData(ancho, alto);
        const data = imgData.data;
        const radioLupa = 120;

        for (let y = 0; y < alto; y++) {
            for (let x = 0; x < ancho; x++) {
                const index = (y * ancho + x) * 4;
                const dx = x - px;
                const dy = y - py;
                const distancia = Math.sqrt(dx * dx + dy * dy);

                let r = 128;
                let g = 128;

                if (distancia < radioLupa) {
                    const factor = Math.sin((distancia / radioLupa) * Math.PI * 0.5) * 40;
                    r = Math.min(255, Math.max(0, 128 + (dx / (distancia || 1)) * factor));
                    g = Math.min(255, Math.max(0, 128 + (dy / (distancia || 1)) * factor));
                }

                data[index] = r;     
                data[index + 1] = g; 
                data[index + 2] = 0;
                data[index + 3] = 255; 
            }
        }

        ctx.putImageData(imgData, 0, 0);
        if (mapElement) {
            mapElement.setAttribute('href', canvas.toDataURL());
        }
    }

    const contenedores = document.querySelectorAll('.contenedor-efecto');

    contenedores.forEach((contenedor) => {
        const el = contenedor as HTMLElement;

        el.addEventListener('mouseenter', () => {
            el.classList.add('activo');
        });

        el.addEventListener('mousemove', (e: Event) => {
            const mouseEvent = e as MouseEvent;
            const rect = el.getBoundingClientRect();
            
            const x = mouseEvent.clientX - rect.left;
            const y = mouseEvent.clientY - rect.top;

            generarMapaLupa(x, y, Math.round(rect.width), Math.round(rect.height));
        });

        el.addEventListener('mouseleave', () => {
            el.classList.remove('activo');
        });
    });
</script>