---
import Layout from '../layouts/maestra.astro';
---

<Layout title="la otra altura del suelo — Leyre Serafina Gutiérrez Cruz">
    <div class="scroll-container">
        <div class="pin-wrapper-global" id="pinGlobal">
            
            <div class="panel-sub" id="escena2">
                <video class="video-detalles-pantalla-completa" autoplay loop muted playsinline>
                    <source src="/detalles_carton_2.mp4" type="video/mp4" />
                    Tu navegador no soporta la reproducción de video.
                </video>
            </div>

            <div class="mask-colapso" id="maskColapso">
                <section class="panel" id="escena1">
                    <div class="seccion-stopmotion">
                        <div class="cuadricula-stopmotion">
                            <div class="contenedor-stopmotion" data-grupo="0">
                            <img src="/2.avif" alt="Frame 2" class="img-stopmotion" />
                            <img src="/3.avif" alt="Frame 3" class="img-stopmotion" />
                            <img src="/4.avif" alt="Frame 4" class="img-stopmotion" />
                            <img src="/5.avif" alt="Frame 5" class="img-stopmotion" />
                            <img src="/6.avif" alt="Frame 6" class="img-stopmotion" />
                            <img src="/7.avif" alt="Frame 7" class="img-stopmotion" />
                            <img src="/8.avif" alt="Frame 8" class="img-stopmotion" />
                            <img src="/9.avif" alt="Frame 9" class="img-stopmotion" />
                            <img src="/10.avif" alt="Frame 10" class="img-stopmotion" />
                            <img src="/11.avif" alt="Frame 11" class="img-stopmotion" />
                        </div>
                        <div class="contenedor-stopmotion" data-grupo="1">
                            <img src="/2.avif" alt="Frame 2" class="img-stopmotion" />
                            <img src="/3.avif" alt="Frame 3" class="img-stopmotion" />
                            <img src="/4.avif" alt="Frame 4" class="img-stopmotion" />
                            <img src="/5.avif" alt="Frame 5" class="img-stopmotion" />
                            <img src="/6.avif" alt="Frame 6" class="img-stopmotion" />
                            <img src="/7.avif" alt="Frame 7" class="img-stopmotion" />
                            <img src="/8.avif" alt="Frame 8" class="img-stopmotion" />
                            <img src="/9.avif" alt="Frame 9" class="img-stopmotion" />
                            <img src="/10.avif" alt="Frame 10" class="img-stopmotion" />
                            <img src="/11.avif" alt="Frame 11" class="img-stopmotion" />
                        </div>
                        <div class="contenedor-stopmotion" data-grupo="2">
                            <img src="/2.avif" alt="Frame 2" class="img-stopmotion" />
                            <img src="/3.avif" alt="Frame 3" class="img-stopmotion" />
                            <img src="/4.avif" alt="Frame 4" class="img-stopmotion" />
                            <img src="/5.avif" alt="Frame 5" class="img-stopmotion" />
                            <img src="/6.avif" alt="Frame 6" class="img-stopmotion" />
                            <img src="/7.avif" alt="Frame 7" class="img-stopmotion" />
                            <img src="/8.avif" alt="Frame 8" class="img-stopmotion" />
                            <img src="/9.avif" alt="Frame 9" class="img-stopmotion" />
                            <img src="/10.avif" alt="Frame 10" class="img-stopmotion" />
                            <img src="/11.avif" alt="Frame 11" class="img-stopmotion" />
                        </div>
                        <div class="contenedor-stopmotion" data-grupo="3">
                            <img src="/2.avif" alt="Frame 2" class="img-stopmotion" />
                            <img src="/3.avif" alt="Frame 3" class="img-stopmotion" />
                            <img src="/4.avif" alt="Frame 4" class="img-stopmotion" />
                            <img src="/5.avif" alt="Frame 5" class="img-stopmotion" />
                            <img src="/6.avif" alt="Frame 6" class="img-stopmotion" />
                            <img src="/7.avif" alt="Frame 7" class="img-stopmotion" />
                            <img src="/8.avif" alt="Frame 8" class="img-stopmotion" />
                            <img src="/9.avif" alt="Frame 9" class="img-stopmotion" />
                            <img src="/10.avif" alt="Frame 10" class="img-stopmotion" />
                            <img src="/11.avif" alt="Frame 11" class="img-stopmotion" />
                        </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>

        </div>
    </div>
</Layout>

<style>
    :global(html, body) {
        margin: 0;
        padding: 0;
        width: 100vw;
        overflow-x: hidden;
        background-color: #ffffff;
        scrollbar-width: none;
    }

    :global(html::-webkit-scrollbar, body::-webkit-scrollbar) {
        display: none;
    }

    .scroll-container {
        width: 100%;
    }

    .pin-wrapper-global {
        position: relative;
        width: 100vw;
        height: 100vh;
        overflow: hidden;
        background-color: #ffffff;
    }

    .mask-colapso {
        width: 100vw;
        height: 100vh;
        position: absolute;
        top: 0;
        left: 0;
        overflow: hidden;
        will-change: height;
        z-index: 5;
    }

    .panel {
        height: 100vh;
        width: 100vw;
        display: flex;
        justify-content: center;
        align-items: center;
        position: absolute;
        top: 0;
        left: 0;
        box-sizing: border-box;
        background-image: url('/light.avif');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        transform-origin: top center;
        will-change: transform;
    }

    .seccion-stopmotion {
        width: 100vw;
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .cuadricula-stopmotion {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 90vw;
        max-width: 1400px;
        gap: 1.5rem;
        position: relative;
        flex-wrap: wrap;
    }

    .contenedor-stopmotion {
        height: 60vh;
        aspect-ratio: 3 / 4;
        overflow: hidden;
        border-radius: 30px;
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;
        flex: 1 1 220px;
        max-width: 280px;
        min-width: 180px;
        cursor: pointer;
        z-index: 10;
        transform-origin: top center;
        will-change: transform;
    }

    .img-stopmotion {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transition: none;
    }

    .img-stopmotion.activo {
        opacity: 1;
    }

    .panel-sub {
        height: 100vh;
        width: 100vw;
        display: flex;
        justify-content: center;
        align-items: center;
        position: absolute;
        bottom: 0;
        left: 0;
        overflow: hidden;
        box-sizing: border-box;
        background-color: #ffffff;
        z-index: 4;
        will-change: height;
    }

    .video-detalles-pantalla-completa {
        width: 100vw;
        height: 100vh;
        object-fit: cover;
        display: block;
        position: absolute;
        bottom: 0;
        left: 0;
        transform-origin: bottom center;
        will-change: transform;
    }

    @media (max-width: 1200px) {
        .contenedor-stopmotion {
            height: 45vh;
            max-width: 240px;
        }
    }

    @media (max-width: 900px) {
        .cuadricula-stopmotion {
            gap: 1rem;
            width: 95vw;
        }
        .contenedor-stopmotion {
            height: 38vh;
            min-width: 40%;
        }
    }

    @media (max-width: 600px) {
        .cuadricula-stopmotion {
            flex-direction: column;
            height: auto;
            padding: 2rem 0;
            overflow-y: auto;
        }
        .contenedor-stopmotion {
            width: 75vw;
            height: auto;
            max-width: 300px;
            min-width: unset;
        }
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);

    const gruposStopMotion = document.querySelectorAll('.contenedor-stopmotion');

    gruposStopMotion.forEach((grupo) => {
        const imagenesFrames = grupo.querySelectorAll('.img-stopmotion');
        const grupoId = parseInt(grupo.getAttribute('data-grupo') || '0', 10);
        const totalFrames = imagenesFrames.length;
        
        let indiceActual = (grupoId * 3) % totalFrames;
        let estaPausado = false;

        function actualizarFrames() {
            imagenesFrames.forEach((img, index) => {
                if (index === indiceActual) img.classList.add('activo');
                else img.classList.remove('activo');
            });
        }

        actualizarFrames();

        setTimeout(() => {
            setInterval(() => {
                if (!estaPausado) {
                    indiceActual = (indiceActual + 1) % totalFrames;
                    actualizarFrames();
                }
            }, 200);
        }, grupoId * 250);

        grupo.addEventListener('mouseenter', () => {
            estaPausado = true;
        });

        grupo.addEventListener('mouseleave', () => {
            estaPausado = false;
        });
    });

    const tlTransicion = gsap.timeline({
        scrollTrigger: {
            trigger: "#pinGlobal",
            start: "top top",
            end: "+=1200",
            pin: true,
            scrub: true
        }
    });

    tlTransicion
        .to("#maskColapso", { height: "0vh", ease: "steps(12)", duration: 1 }, 0)
        .to("#escena1", { scaleY: 0.1, ease: "steps(12)", duration: 1 }, 0)
        .to(".contenedor-stopmotion", { scaleY: 0.1, ease: "steps(12)", duration: 1 }, 0)
        .to("#escena2", { height: "100vh", ease: "steps(12)", duration: 1 }, 0)
        .to(".video-detalles-pantalla-completa", { scaleY: 1, ease: "steps(12)", duration: 1 }, 0);

    gsap.set("#escena2", { height: "0vh" });
    gsap.set(".video-detalles-pantalla-completa", { scaleY: 0.1 });
</script>