---
import Layout from '../layouts/maestra.astro';
---

<Layout title="UNA RAMA + — Leyre Serafina Gutiérrez Cruz">
    <div class="scroll-container">
    
        <section class="panel fondo-bluey-completo" id="escena1">
            <div class="franja-blur-superior"></div>
            <div class="contenido-pantalla-completa">
                <div class="contenedor-imagen-con-fondo">
                    <img src="/llavero_1.avif" alt="Llavero 1" class="imagen-pantalla-completa" id="secuencia-llavero" />
                </div>
            </div>
        </section>

        <section class="panel fondo-video-1" id="escena2">  
            <div class="contenido-obra-con-ascii">
                <div class="contenedor-video" id="contenedor-clic">
                    <video id="mi-video" class="video-obra" autoplay loop playsinline>
                        <source src="/Llaves_2.mp4" type="video/mp4" />
                        Tu navegador no soporta la reproducción de video.
                    </video>
                    <button id="boton-audio" class="btn-audio" type="button" aria-label="Audio">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M11 5L6 9H2v6h4l5 4V5z"></path>
                            <g id="ondas-audio" style="opacity: 1; transition: opacity 0.2s ease;">
                                <path d="M15.5 8.5C16.3 9.3 16.8 10.6 16.8 12s-.5 2.7-1.3 3.5"></path>
                                <path d="M19 5c1.7 1.7 2.8 4 2.8 6.5s-1.1 4.8-2.8 6.5"></path>
                            </g>
                            <line id="linea-mute" x1="4" y1="4" x2="20" y2="20" style="opacity: 0; transition: opacity 0.2s ease;"></line>
                        </svg>
                    </button>
                </div>
            </div>
        </section>

        <section class="panel seccion-galeria-final" id="escena3">
            <div class="visor-mariposa-contenedor">
                <img src="/mariposa.png" alt="Mariposa" class="imagen-mariposa" id="img-mariposa" />
            </div>
        </section>

    </div>
</Layout>

<script>
    const video = document.getElementById('mi-video') as HTMLVideoElement;
    const contenedor = document.getElementById('contenedor-clic');
    const ondasAudio = document.getElementById('ondas-audio');
    const lineaMute = document.getElementById('linea-mute');

    if (video && contenedor && ondasAudio && lineaMute) {
        video.muted = false;
        const actualizarIcono = () => {
            ondasAudio.style.opacity = video.muted ? '0' : '1';
            lineaMute.style.opacity = video.muted ? '1' : '0';
        };
        video.addEventListener('volumechange', actualizarIcono);
        actualizarIcono();
        contenedor.addEventListener('click', () => {
            video.muted = !video.muted;
            actualizarIcono();
        });
    }

    const imgElement = document.getElementById('secuencia-llavero') as HTMLImageElement;
    const imagenes = ['/llavero_1.avif', '/llavero_1.1.png'];
    let indiceActual = 0;
    if (imgElement) {
        setInterval(() => {
            indiceActual = (indiceActual + 1) % imagenes.length;
            imgElement.src = imagenes[indiceActual];
        }, 500); 
    }

  // Stop motion con ráfagas súper rápidas y pausas esporádicas
    const mariposa = document.getElementById('img-mariposa') as HTMLImageElement;
    const fuentesMariposa = ['/mariposa.png', '/mariposa_2.png'];
    let indiceMariposa = 0;

    if (mariposa) {
        const cambiarMariposa = () => {
            indiceMariposa = (indiceMariposa + 1) % fuentesMariposa.length;
            mariposa.src = fuentesMariposa[indiceMariposa];

            // 80% de las veces va a tope (entre 50ms y 120ms)
            // 20% de las veces mete el freno y se queda un segundo (1000ms)
            const esLento = Math.random() < 0.20; 
            
            let tiempoAleatorio;
            if (esLento) {
                tiempoAleatorio = 1000; // El momento lento de 1 segundo
            } else {
        
                tiempoAleatorio = Math.floor(Math.random() * (160 - 120 + 1)) + 120;
            }

            setTimeout(cambiarMariposa, tiempoAleatorio);
        };

        // Iniciar el ciclo
        setTimeout(cambiarMariposa, 500);
    }

    let isScrolling = false;
    window.addEventListener("wheel", (e) => {
        if (isScrolling) return;
        const maxScroll = window.innerHeight * 2; 
        
        if (window.scrollY < maxScroll) {
            e.preventDefault(); 
            isScrolling = true;
            window.scrollBy({
                top: (e.deltaY > 0 ? 1 : -1) * 35,
                behavior: "auto"
            });
            setTimeout(() => { isScrolling = false; }, 90); 
        }
    }, { passive: false });
</script>

<style>
    :global(html, body) { 
        margin: 0; 
        padding: 0; 
        width: 100vw; 
        overflow-x: hidden; 
        background-color: #ffffffef; 
    }

    .scroll-container { 
        width: 100%; 
    }

    .panel { 
        height: 100vh; 
        width: 100vw; 
        display: flex; 
        justify-content: center; 
        align-items: center; 
        position: relative; 
        overflow: hidden; 
        box-sizing: border-box;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }

    .fondo-bluey-completo {
        background-image: url('/2014.jpg'); 
        filter: grayscale(3);
        -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 85%, rgba(0,0,0,0) 100%);
        mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 85%, rgba(0,0,0,0) 100%);
    }

    .contenido-pantalla-completa {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2vh 2vw;
        box-sizing: border-box;
    }

    .contenedor-imagen-con-fondo {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        transform: translateX(30vw) translateY(8vw); 
    }

    .imagen-pantalla-completa {
        position: relative;
        z-index: 2;
        width: auto;
        height: auto;
        max-width: 28vw; 
        max-height: 65vh;
        object-fit: contain;
        display: block;
    }

    .franja-blur-superior {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 140px; 
        z-index: 100;
        pointer-events: none;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        background: rgba(255, 255, 255, 0.35);
        mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 15%, rgba(0,0,0,0) 90%);
        -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 15%, rgba(0,0,0,0) 90%);
    }

    .fondo-video-1 {
        background-image: url('/hojas2.avif');
        -webkit-mask-image: linear-gradient(to top, rgba(0,0,0,1) 85%, rgba(0,0,0,0) 100%);
        mask-image: linear-gradient(to top, rgba(0,0,0,1) 85%, rgba(0,0,0,0) 100%);
    }

    .contenido-obra-con-ascii {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5vw;
        width: 90%;
        max-width: 1400px;
    }

    .contenedor-video {
        position: relative;
        width: fit-content;
        cursor: pointer;
    }

    .video-obra {
        max-width: 100%;
        max-height: 68vh; 
        object-fit: contain; 
        display: block;
        pointer-events: none;
    }

    .btn-audio {
        position: absolute;
        bottom: 16px;
        left: 16px;
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 0;
        line-height: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        filter: drop-shadow(0px 1px 3px rgba(0, 0, 0, 0.7));
        z-index: 10;
    }

    .seccion-galeria-final {
        align-items: center;
        padding: 0;
        background: transparent;
    }

    .visor-mariposa-contenedor {
        width: 100vw;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        z-index: 10;
        box-sizing: border-box;
        padding: 0;
    }

    .imagen-mariposa {
        width: 100vw;
        height: 100vh;
        object-fit: cover;
        display: block;
    }
</style>