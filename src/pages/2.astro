---
import Layout from '../layouts/maestra.astro';
---

<Layout title="2" pantallaCompleta={true}>
    <div class="media-luna-fondo"></div>
    
    <div class="scroll-container">
        
        <section class="panel" id="escena1">
            <div class="contenido-pantalla-completa">
                <div class="contenedor-imagen-con-fondo">
                    <img src="/llavero_1.avif" alt="Llavero 1" class="imagen-pantalla-completa" id="secuencia-llavero" />
                </div>
            </div>
        </section>

        <section class="panel" id="escena2">  
            <div class="contenedor-video" id="contenedor-clic">
                <video id="mi-video" class="video-obra" autoplay muted loop playsinline preload="auto">
                    <source src="/hojitas_video.mp4" type="video/mp4" />
                    Tu navegador no soporta la reproducción de video.
                </video>
                <button id="boton-audio" class="btn-audio" type="button" aria-label="Audio">
                    <span class="contenedor-icono-musical">
                        <span class="simbolo-musical">♫</span>
                        <span id="barra-tachar" class="barra-tachado"></span>
                    </span>
                </button>
            </div>
        </section>

    </div>
</Layout>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);

    // 1. Control del vídeo y audio
    const video = document.getElementById('mi-video') as HTMLVideoElement;
    const contenedor = document.getElementById('contenedor-clic');
    const barraTachar = document.getElementById('barra-tachar');

    if (video && contenedor && barraTachar) {
        video.muted = false; 
        const actualizarIcono = () => {
            barraTachar.style.opacity = video.muted ? '1' : '0';
        };
        video.addEventListener('volumechange', actualizarIcono);
        actualizarIcono();
        
        contenedor.addEventListener('click', () => {
            video.muted = !video.muted;
            actualizarIcono();
        });
    }

    // 2. Secuencia del llavero (Escena 1)
    const imgElement = document.getElementById('secuencia-llavero') as HTMLImageElement;
    const imagenes = ['/llavero_1.avif', '/llavero_1.1.avif'];
    let indiceActual = 0;
    if (imgElement) {
        setInterval(() => {
            indiceActual = (indiceActual + 1) % imagenes.length;
            imgElement.src = imagenes[indiceActual];
        }, 500); 
    }

    // 3. Ocultar la media luna al llegar al final
    ScrollTrigger.create({
        trigger: "#escena2",
        start: "top center",
        onEnter: () => {
            gsap.to(".media-luna-fondo", { opacity: 0, duration: 0.1 });
        },
        onLeaveBack: () => {
            gsap.to(".media-luna-fondo", { opacity: 1, duration: 0.1 });
        }
    });

    // 4. Control de inercia del scroll
    let isScrolling = false;
    window.addEventListener("wheel", (e) => {
        if (isScrolling) return;
        const scrollY = window.scrollY;
        const windowHeight = window.innerHeight;
        
        if (scrollY < windowHeight * 2) {
            e.preventDefault(); 
            isScrolling = true;
            const jumpSize = 80; 
            const direction = e.deltaY > 0 ? 1 : -1;
            window.scrollBy({ top: direction * jumpSize, behavior: "auto" });
            setTimeout(() => { isScrolling = false; }, 120); 
        }
    }, { passive: false });
</script>

<style>
    :global(html, body) { 
        width: 100vw; 
        overflow-x: hidden; 
        background-color: #ffffff; 
        scrollbar-width: none; 
    }

    :global(html::-webkit-scrollbar, body::-webkit-scrollbar) {
        display: none;
    }

    .media-luna-fondo {
        position: fixed;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 155vw;
        height: 180px;
        background: linear-gradient(to bottom, 
            rgba(255, 255, 255, 1) 0%, 
            rgba(255, 255, 255, 0.85) 30%, 
            rgba(255, 255, 255, 0.4) 65%, 
            rgba(255, 255, 255, 0) 100%
        );
        filter: blur(25px);
        border-radius: 0 0 50% 50%;
        z-index: 998;
        pointer-events: none;
        will-change: opacity;
    }

    .scroll-container { 
        width: 100%; 
    }

    .panel { 
        height: 100vh; 
        width: 100vw; 
        display: flex; 
        justify-content: center; 
        align-items: center; 
        position: relative; 
        overflow: hidden; 
        box-sizing: border-box;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }

    #escena1 {
        background-image: url('/2014.avif'); 
        filter: grayscale(3);
        -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 85%, rgba(0,0,0,0) 100%);
        mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 85%, rgba(0,0,0,0) 100%);
    }

    .contenido-pantalla-completa {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2vh 2vw;
        box-sizing: border-box;
    }

    .contenedor-imagen-con-fondo {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        transform: translateX(28vw) translateY(7vw); 
    }

    .imagen-pantalla-completa {
        position: relative;
        z-index: 2;
        width: auto;
        height: auto;
        max-width: 36vw; 
        max-height: 73vh;
        object-fit: contain;
        display: block;
    }

    #escena2 {
        background-image: url('/hojas2.avif');
        -webkit-mask-image: linear-gradient(to top, rgba(0,0,0,1) 85%, rgba(0,0,0,1) 100%);
        mask-image: linear-gradient(to top, rgba(0,0,0,1) 85%, rgba(0,0,0,1) 100%);
    }

    .contenedor-video {
        position: relative;
        width: fit-content;
        cursor: pointer;
    }

    .video-obra {
        max-width: 100%;
        max-height: 68vh; 
        object-fit: contain; 
        display: block;
        pointer-events: none;
    }

    .btn-audio {
        position: absolute;
        bottom: 16px;
        left: 16px;
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 0;
        line-height: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        z-index: 10;
    }

    .contenedor-icono-musical {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .simbolo-musical {
        font-size: 24px;
        font-family: serif;
        display: inline-block;
    }

    .barra-tachado {
        position: absolute;
        width: 100%;
        height: 2px;
        background-color: white;
        top: 50%;
        left: 0;
        transform: rotate(-45deg);
        opacity: 0;
        transition: opacity 0.2s ease;
    }
</style>