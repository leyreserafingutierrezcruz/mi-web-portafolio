---
import Layout from '../layouts/maestra.astro';
---

<Layout showSplash={true} title="Leyre Serafina Gutiérrez Cruz">
    <div class="contenedor-principal-inicio">
        <!-- Contenedor de las 4 obras amarillas -->
        <div class="obras-grupo">
            <a href="/obras/obra-1" class="franja-obra"><h3 class="titulo-obra">Y-URBE</h3></a>
            <a href="/obras/obra-2" class="franja-obra"><h3 class="titulo-obra">UNA RAMA +</h3></a>
            <a href="/obras/obra-3" class="franja-obra"><h3 class="titulo-obra">EXTRUIR LA DISTANCIA</h3></a>
            <a href="/obras/obra-4" class="franja-obra"><h3 class="titulo-obra">DONDE QUEDAN LOS ESPACIOS?</h3></a>
        </div>
        
        <!-- Franja azul del CV -->
        <a href="/leyreserafina" class="franja-nombre-azul franja-azul-compacta">
            <h2 class="titulo-nombre-azul">LEYRE SERAFINA GUTIERREZ CRUZ</h2>
            <span class="etiqueta-info-azul">+ CV / BIO</span>
        </a>
    </div>
</Layout>

<style>
   :global(html), :global(body) {
        overflow: hidden !important;
        height: 100vh !important;
        margin: 0 !important;
        padding: 0 !important;
        background-color: transparent !important;
    }

  :global(body) {
        background-image: url('/public/piolin.jpg') !important;
        background-size: cover !important;
        background-position: center !important;
        background-repeat: no-repeat !important;
    }
    .contenedor-principal-inicio {
        /* Centramos verticalmente todo el bloque de obras y la barra azul */
        height: calc(100vh - 120px);
        display: flex;
        flex-direction: column;
        align-items: stretch;
        justify-content: center; /* Centra las barras en el medio de la pantalla */
        gap: 12px;               /* Espacio equilibrado entre barra y barra */
        box-sizing: border-box;
        padding: 0rem;
        width: 100%;
    }

    .obras-grupo {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        justify-content: center;
        gap: 14px;
        width: 100%;
    }

    .franja-obra {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background-color: #ffe65d;
        text-decoration: none;
        box-sizing: border-box;
        padding: 0.1rem 2rem; 
        width: 100%;
        transition: background-color 0.2s ease;
    }

    .franja-obra:hover {
        background-color: #fff695;
    }

    .titulo-obra {
        font-size: 3rem; 
        font-weight: 900;
        color: #d2384a;
        text-transform: uppercase;
        margin: 0;
        letter-spacing: 1px;
        line-height: 1;
    }

    .franja-azul-compacta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.5rem 2rem; 
        box-sizing: border-box;
        width: 100%;
    }

    .franja-azul-compacta .titulo-nombre-azul {
        font-size: 2rem;
        margin: 0;
        line-height: 1;
    }
</style>