
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="ִֶָ𓂃 ࣪˖ ִֶָ🫑་༘࿐" />
		<title>Leyre Serafina Gutiérrez Cruz</title>

		<style>
		/*poner la fuente que quiera*/
		@font-face {
			font-family: 'AMANO'; 
			src: url('/fonts/MyUglyHandwriting-Regular.otf') format('opentype'); 
			font-weight: normal;
			font-style: normal;
			font-display: swap;
		}
	
		#splash-screen {
			position: fixed;
			top: 0; left: 0; width: 100%; height: 100%;
			background: white;
			background: url('/fondo_pared.jpg') no-repeat center center fixed; background-size: cover;
			display: flex;
			justify-content: center;
			align-items: center;
			z-index: 9999;
			cursor: pointer;
			transition: opacity 0.4s ease;
		}

	
		.fade-out {
			opacity: 0;
			pointer-events: none;
		}

		.obras-franjas-container {
			display: flex;
			flex-direction: column;
			width: 100%;
			margin-top: 3rem;
			gap: 1.5rem;
    	}

		/* Cada franja horizontal */
    	.franja-obra {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 1rem 1rem;  
			background-color: #ffe65d; 
			border-bottom: 3px solid #faf9f5; 
			text-decoration: none;
			transition: background-color 0.2s ease;
    	}

    	.franja-obra:hover {
       		 background-color: #fff695;
    	}
		
    	.titulo-obra {
			font-family: 'AMANO', sans-serif;
			font-size: 3rem;
			font-weight: 900;
			color: #d2384a; 
			text-transform: uppercase;
			margin: 0;
			margin-left: 2rem;         
			text-align: right;          
			letter-spacing: 1px;
			transition: font-weight 0.1s ease; 
    	}

		.franja-obra:hover .titulo-obra {
        	font-weight: 1000;
		}
		

    	/* Contenedor para el texto lateral y el garabato */
    	.detalle-lateral {
        display: flex;
        align-items: center;
        gap: 1rem;
    	}

   		.etiqueta-tipo {
        font-family:'AMANO';
        font-size: 1rem;
        color: #d2384a;
    	}

    	/* El dibujito/garabato al lado del título */
    	.garabato-obra {
        height: 35px;
        width: auto;
    	}	
		</style>
	</head>

	<body>
    	<div id="splash-screen">
		<img src="/v2.svg" alt="Logo" style="max-width: 600px;" />
		</div>

		<div class="obras-franjas-container">
    
    	<!-- Franjas Obras -->
    	<a href="/obras/obra-1" class="franja-obra">
			<h3 class="titulo-obra">Y-URBE</h3>
			<div class="detalle-lateral">
				<span class="etiqueta-tipo">Live</span>
				<img src="/vv.png" alt="dibujo" class="garabato-obra" />
			</div>
    	</a>

		<a href="/obras/obra-2" class="franja-obra">
			<h3 class="titulo-obra">UNA RAMA +</h3>
			<div class="detalle-lateral">
				<span class="etiqueta-tipo">Visuals</span>
				<img src="/vv.png" alt="dibujo" class="garabato-obra" />
			</div>
		</a>

  
		<a href="/obras/obra-3" class="franja-obra">
			<h3 class="titulo-obra">EXTRUIR LA DISTANCIA</h3>
			<div class="detalle-lateral">
				<span class="etiqueta-tipo">Video</span>
				<img src="/vv.png" alt="dibujo" class="garabato-obra" />
			</div>
		</a>


		<a href="/obras/obra-4" class="franja-obra">
			<h3 class="titulo-obra">DONDE QUEDAN LOS ESPACIOS?</h3>
			<div class="detalle-lateral">
				<span class="etiqueta-tipo">Stop-Motion</span>
				<img src="/vv.png" alt="dibujo" class="garabato-obra" />
			</div>
		</a>

</div>

		<script>
		const splash = document.getElementById('splash-screen')!;

		splash.addEventListener('click', () => {
			splash.classList.add('fade-out');
		});
		</script>
	</body>
</html>
