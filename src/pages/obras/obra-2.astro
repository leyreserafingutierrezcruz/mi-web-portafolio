---
import Layout from '../../layouts/maestra.astro';
---

<Layout title="UNA RAMA + — Leyre Serafina Gutiérrez Cruz">
    
    <!-- SECCIÓN 1 -->
    <section class="seccion-bloque fondo-bluey-completo seccion-pantalla-completa">
        <div class="franja-blur-superior"></div>
        <div class="contenido-pantalla-completa">
            <div class="contenedor-imagen-con-fondo">
                <img src="/llavero_1.png" alt="Llavero 1" class="imagen-pantalla-completa" />
            </div>
        </div>
    </section>

    <!-- SECCIÓN 2 (VÍDEO) -->
    <section class="seccion-bloque fondo-video-1">
        <div class="contenido-obra">
            <div class="contenedor-video" id="contenedor-clic">
                <video id="mi-video" class="video-obra" autoplay muted loop playsinline>
                    <source src="/Llaves_2.mp4" type="video/mp4" />
                    Tu navegador no soporta la reproducción de video.
                </video>
                
                <button id="boton-audio" class="btn-audio" type="button" aria-label="Activar o desactivar sonido">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M11 5L6 9H2v6h4l5 4V5z"></path>
                        <g id="ondas-audio" style="opacity: 0; transition: opacity 0.2s ease;">
                            <path d="M15.5 8.5C16.3 9.3 16.8 10.6 16.8 12s-.5 2.7-1.3 3.5"></path>
                            <path d="M19 5c1.7 1.7 2.8 4 2.8 6.5s-1.1 4.8-2.8 6.5"></path>
                        </g>
                        <line id="linea-mute" x1="4" y1="4" x2="20" y2="20" style="opacity: 1; transition: opacity 0.2s ease;"></line>
                    </svg>
                </button>
            </div>
        </div>
    </section>

    <!-- SECCIÓN 3 -->
    <section class="seccion-final-ajustada fondo-detalle-2">
        <div class="contenido-galeria-final">
            <img src="/llavero_2.JPG" alt="Llavero 2" class="imagen-izquierda-borde" />
            <img src="/llavero_3.JPG" alt="Llavero 3" class="imagen-derecha-borde" />
        </div>
    </section>

</Layout>

<script>
    const video = document.getElementById('mi-video') as HTMLVideoElement;
    const contenedor = document.getElementById('contenedor-clic');
    const ondasAudio = document.getElementById('ondas-audio');
    const lineaMute = document.getElementById('linea-mute');

    if (video && contenedor && ondasAudio && lineaMute) {
        const actualizarIcono = () => {
            if (video.muted) {
                ondasAudio.style.opacity = '0';
                lineaMute.style.opacity = '1';
            } else {
                ondasAudio.style.opacity = '1';
                lineaMute.style.opacity = '0';
            }
        };

        actualizarIcono();

        contenedor.addEventListener('click', () => {
            video.muted = !video.muted;
            actualizarIcono();
        });
    }
</script>

<style>
    :global(html), :global(body) {
        margin: 0;
        padding: 0;
        width: 100%;
        overflow-x: hidden;
    }

    .seccion-bloque {
        width: 100%;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        padding: 4rem 2rem;
    }

    .fondo-bluey-completo {
        background-image: url('/metal_2.jpg'); 
        -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 85%, rgba(0,0,0,0) 100%);
        mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 85%, rgba(0,0,0,0) 100%);
    }

    .fondo-video-1 {
        background-image: url('/hojas2.jpg');
        -webkit-mask-image: linear-gradient(to top, rgba(0,0,0,1) 85%, rgba(0,0,0,0) 100%);
        mask-image: linear-gradient(to top, rgba(0,0,0,1) 85%, rgba(0,0,0,0) 100%);
    }

    .seccion-final-ajustada {
        width: 100%;
        height: calc(100vh - 100px); 
        box-sizing: border-box;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        padding: 0 2vw;
        display: flex;
        align-items: flex-end;
        position: relative;
        overflow: hidden; /* Evita que la sección genere scroll interno no deseado */
    }

    .fondo-detalle-2 {
        background-image: url('/fondo-detalle2.jpg'); 
    }

    .contenido-galeria-final {
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: left;
        gap: 25vw;
        align-items: flex-end;
        position: relative;
        box-sizing: border-box;
        overflow: visible;
    }

    /* Imagen izquierda: tamaño exacto en vh equivalente al anterior para mantener proporciones */
    .imagen-izquierda-borde {
        width: auto;
        max-width: 42vw;
        height: 85vh; 
        object-fit: contain;
        display: block;
        align-self: flex-start;
        margin-top: 0vh;
        position: relative;
        z-index: 10;
    }

    /* Imagen derecha: tamaño exacto en vh equivalente al anterior para mantener proporciones */
    .imagen-derecha-borde {
        width: auto;
        max-width: 52vw;
        height: 50vh; 
        object-fit: contain;
        display: block;
        align-self: flex-start;
        margin-top: 0vh;
        position: relative;
        z-index: 10;
    }

    .seccion-pantalla-completa {
        padding: 0;
        height: 100vh;
        position: relative;
        box-sizing: border-box;
        overflow: hidden;
    }

    .contenido-pantalla-completa {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2vh 2vw;
        box-sizing: border-box;
    }

    .contenedor-imagen-con-fondo {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        transform: translateX(20vw) translateY(8vw); 
    }

    .imagen-pantalla-completa {
        position: relative;
        z-index: 2;
        width: auto;
        height: auto;
        max-width: 62%;
        max-height: 75vh;
        object-fit: contain;
    }

    .franja-blur-superior {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 140px; 
        z-index: 100;
        pointer-events: none;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        background: rgba(255, 255, 255, 0.35);
        mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 15%, rgba(0,0,0,0) 90%);
        -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 15%, rgba(0,0,0,0) 90%);
    }

    .contenido-obra {
        max-width: 1200px;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .contenedor-video {
        position: relative;
        width: fit-content;
        cursor: pointer;
    }

    .video-obra {
        max-width: 100%;
        max-height: 68vh; 
        object-fit: contain; 
        display: block;
        pointer-events: none;
    }

    .btn-audio {
        position: absolute;
        bottom: 16px;
        left: 16px;
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 0;
        line-height: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        filter: drop-shadow(0px 1px 3px rgba(0, 0, 0, 0.7));
        transition: transform 0.2s ease;
    }

    .btn-audio:hover {
        transform: scale(1.1);
    }
</style>