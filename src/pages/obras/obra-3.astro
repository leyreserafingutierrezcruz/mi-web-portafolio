---
import Layout from '../../layouts/maestra.astro';
---

<Layout title="EXTRUIR LA DISTANCIA — Leyre Serafina Gutiérrez Cruz">
    <div class="contenido-obra">
        <div class="galeria-pantalla-completa">
            <img src="/prueba.jpg" alt="Extruir la distancia - Serie Poliuretano" />
        </div>
    </div>
</Layout>

<style>
    :global(html, body) {
        overflow-x: hidden;
        max-width: 100vw;
    }

    .contenido-obra {
        margin-top: 130px;
        padding-bottom: 4rem;
        box-sizing: border-box;
        width: 100%;
        max-width: 100%;
        overflow-x: hidden;
    }

    .galeria-pantalla-completa {
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 3rem;
        box-sizing: border-box;
    }

    .galeria-pantalla-completa img {
        width: 100%;
        height: auto;
        display: block;
        border-radius: 4px;
    }
</style>