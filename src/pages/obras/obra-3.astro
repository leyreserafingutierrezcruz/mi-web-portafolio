---
import Layout from '../../layouts/maestra.astro';
---

<Layout title="EXTRUIR LA DISTANCIA — Leyre Serafina Gutiérrez Cruz">
    
    <!-- Contenedor donde aparecerán las estelas del ratón -->
    <div class="rastros-container" id="rastros-container"></div>

    <div class="contenido-obra">
        <div class="galeria-lado-a-lado">
            <img src="/IMG_5882.JPG" alt="IMG 5882" class="imagen-galeria" />
            <img src="/IMG_5884.JPG" alt="IMG 5884" class="imagen-galeria" />
        </div>
    </div>

</Layout>

<script>
    const container = document.getElementById('rastros-container');

    if (container) {
        window.addEventListener('mousemove', (e) => {
            // Creamos un elemento por cada movimiento para dejar el rastro
            const rastro = document.createElement('div');
            rastro.className = 'punto-rastro';
            
            // Posicionamos el punto exactamente donde está el cursor
            rastro.style.left = `${e.clientX}px`;
            rastro.style.top = `${e.clientY}px`;
            
            container.appendChild(rastro);

            // El rastro se desvanece y se elimina automáticamente transcurrido 1 segundo (1000ms)
            setTimeout(() => {
                rastro.style.opacity = '0';
                setTimeout(() => {
                    rastro.remove();
                }, 300); // Tiempo extra para que la transición de opacidad sea suave
            }, 1000);
        });
    }
</script>

<style>
    :global(html, body) {
        margin: 0;
        padding: 0;
        overflow-x: hidden;
        max-width: 100vw;
        background-color: #ffffff;
    }

    /* Contenedor de las marcas del rastro */
    .rastros-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        pointer-events: none;
        z-index: 1;
    }

    /* Estilo de cada punto/mancha térmica que deja el ratón */
    :global(.punto-rastro) {
        position: absolute;
        width: 120px;
        height: 120px;
        transform: translate(-50%, -50%);
        pointer-events: none;
        border-radius: 50%;
        background: radial-gradient(
            circle,
            rgba(255, 69, 0, 0.4),   /* Núcleo cálido */
            rgba(255, 215, 0, 0.25),  /* Transición amarilla */
            rgba(0, 100, 80, 0.1),    /* Verde térmico exterior */
            transparent 70%
        );
        transition: opacity 0.3s ease-out;
        opacity: 1;
    }

    .contenido-obra {
        position: relative;
        z-index: 2; /* Por encima de los rastros */
        margin-top: 130px;
        padding-bottom: 4rem;
        box-sizing: border-box;
        width: 100%;
        min-height: calc(100vh - 130px);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .galeria-lado-a-lado {
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem;
        box-sizing: border-box;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.2rem; /* Distancia ajustada a 0.2 */
    }

    .imagen-galeria {
        width: auto;
        max-width: 88vw;
        max-height: 80vh;
        object-fit: contain;
        display: block;
        border-radius: 0;
        box-shadow: none;
    }
</style>