---
import Layout from '../../layouts/maestra.astro';
---

<Layout title="la otra altura del suelo — Leyre Serafina Gutiérrez Cruz">
    <div class="pantalla-completa">
        <div class="contenedor-imagenes">
            <div class="contenedor-efecto img-izquierda">
                <img src="/edit_city2.avif" alt="izquierda" class="img-obra img-izquierda-style" />
                <div class="destello-espejo mask-izq"></div>
            </div>
            <div class="contenedor-efecto img-centro">
                <img src="/edit_city.avif" alt="centro" class="img-obra img-centro-style" />
                <div class="destello-espejo mask-cen flip-horizontal"></div>
            </div>
            <div class="contenedor-efecto img-derecha">
                <img src="/edit_city.avif" alt="derecha" class="img-obra img-derecha-style" />
                <div class="destello-espejo mask-der"></div>
            </div>
        </div>
    </div>
</Layout>

<style>
    :global(html), :global(body) {
        overflow: hidden !important;
        height: 100vh !important;
        width: 100vw !important;
        margin: 0;
    }

    :global(body) {
        background-image: 
            linear-gradient(rgba(255, 255, 255, 0.3), rgba(255, 255, 255, 0.3)), 
            url('/metal.avif') !important;
        background-size: cover !important;
        background-position: center !important;
        background-repeat: no-repeat !important;
    }

    .pantalla-completa {
        position: relative;
        width: 100vw;
        height: calc(100vh - 120px);
        display: flex;
        justify-content: center;
        align-items: center;
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        top: 90px; 
    }

    .contenedor-imagenes {
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;
        width: 100%;
        height: 100vw; 
        margin-left: -20vw; 
        gap: 1vw; 
    }

    .contenedor-efecto {
        position: relative;
        display: inline-block;
        cursor: pointer;
    }

    .img-obra {
        width: auto;
        object-fit: contain;
        display: block;
    }

    /* El destello vertical dentro de la figura */
    .destello-espejo {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        opacity: 0;
        z-index: 10;
        
        background: linear-gradient(
            to bottom,
            transparent 0%,
            rgba(255, 0, 90, 0.2) 30%,
            rgba(255, 230, 0, 0.6) 45%,
            rgba(255, 255, 255, 0.95) 50%,
            rgba(0, 230, 255, 0.6) 55%,
            rgba(150, 0, 255, 0.4) 70%,
            transparent 100%
        );
        
        background-size: 100% 300%;
        background-position: center -100%;
        
        mix-blend-mode: color-dodge;
        
        -webkit-mask-size: contain;
        mask-size: contain;
        -webkit-mask-repeat: no-repeat;
        mask-repeat: no-repeat;
        -webkit-mask-position: center;
        mask-position: center;
    }

    /* Incontestable: espejo horizontal para que coincida exactamente con el scaleX(-1) de la imagen central */
    .flip-horizontal {
        transform: scaleX(-1);
    }

    /* Máscaras individuales */
    .mask-izq {
        -webkit-mask-image: url('/edit_city2.avif');
        mask-image: url('/edit_city2.avif');
    }
    .mask-cen, .mask-der {
        -webkit-mask-image: url('/edit_city.avif');
        mask-image: url('/edit_city.avif');
    }

    /* Animación vertical de arriba hacia abajo respetando la inversión si la tiene */
    @keyframes barridoVertical {
        0% {
            background-position: center -150%;
            opacity: 0;
        }
        20% {
            opacity: 1;
        }
        80% {
            opacity: 1;
        }
        100% {
            background-position: center 250%;
            opacity: 0;
        }
    }

    .contenedor-efecto:hover .destello-espejo {
        animation: barridoVertical 1.2s ease-in-out forwards;
    }

    /* Tamaños y estilos de las imágenes */
    .img-derecha {
        max-height: 82vh; 
        transform: translateY(3px); 
        z-index: 1;
    }
    .img-derecha-style {
        max-height: 82vh;
    }

    .img-centro {
        max-height: 72vh; 
        z-index: 2;
    }
    .img-centro-style {
        max-height: 72vh;
        transform: scaleX(-1) translateY(0px); 
        filter: grayscale(100%) brightness(1.05); 
    }

    .img-izquierda {
        max-height: 68vh; 
        z-index: 3;
    }
    .img-izquierda-style {
        max-height: 68vh;
        transform: translateY(0px); 
        filter: grayscale(100%) brightness(1.15); 
    }

    @media (max-width: 768px) {
        .pantalla-completa {
            height: calc(100vh - 100px);
            padding: 1rem;
            overflow-y: auto;
            top: 0;
        }
        .contenedor-imagenes {
            flex-direction: column;
            gap: 1rem;
            height: auto;
            margin-left: 0;
        }
        .contenedor-efecto {
            max-height: 35vh !important;
            transform: none !important;
        }
    }
</style>