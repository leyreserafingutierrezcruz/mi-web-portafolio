---
import Layout from '../layouts/maestra.astro';
---

<Layout title="EXTRUIR LA DISTANCIA — Leyre Serafina Gutiérrez Cruz">
    <div class="scroll-container">
        
        <section class="seccion-video">
            <video class="video-detalles-pantalla-completa" autoplay loop muted playsinline>
                <source src="/handbrake.mp4" type="video/mp4" />
                Tu navegador no soporta la reproducción de video.
            </video>
        </section>

        <section class="seccion-foto-full" id="seccionIman">
            <img src="/DSC07575.JPG" alt="DSC07575" class="imagen-full-screen" />
        </section>

        <section class="seccion-composicion" id="seccionRainbow">
            <div class="fondo-rainbow"></div>
            
            <div class="contenedor-collage">
                <img src="/DSC07534.JPG" alt="DSC07534" class="foto-izquierda" />
                <img src="/DSC07544.JPG" alt="DSC07544" class="foto-derecha" />
            </div>
        </section>

    </div>
</Layout>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);

    ScrollTrigger.create({
        trigger: "#seccionIman",
        start: "top 80%",
        onEnter: () => document.body.classList.add("mostrar-marquesina"),
        onLeaveBack: () => document.body.classList.remove("mostrar-marquesina")
    });

    ScrollTrigger.create({
        trigger: "#seccionIman",
        start: "top top",
        end: "+=500",
        pin: true,
        scrub: true,
        snap: {
            snapTo: 1,      
            duration: 0.4,   
            ease: "power2.inOut"
        }
    });
</script>

<style>
    :global(.sub-superior) {
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.4s ease, visibility 0.4s ease;
    }

    :global(body.mostrar-marquesina) :global(.sub-superior) {
        opacity: 1;
        visibility: visible;
    }

    :global(.logo-inicio-flotante) {
        top: 15px !important;
        transition: top 0.4s ease !important;
    }

    :global(body.mostrar-marquesina) :global(.logo-inicio-flotante) {
        top: 35px !important;
    }

    :global(html, body) { 
        margin: 0; 
        padding: 0; 
        width: 100vw; 
        overflow-x: hidden; 
        background-color: #ffffff; 
        scrollbar-width: none; 
    }
    
    :global(html::-webkit-scrollbar, body::-webkit-scrollbar) {
        display: none;
    }

    .scroll-container { 
        width: 100vw; 
        position: relative;
    }

    .seccion-video {
        width: 100vw;
        height: 100vh;
        position: relative;
        background-color: #ffffff;
    }

    .video-detalles-pantalla-completa {
        width: 100vw;
        height: 100vh;
        object-fit: cover;
        display: block;
    }

    .seccion-foto-full {
        width: 100vw;
        height: 100vh;
        position: relative;
        overflow: hidden;
        background-color: #ffffff;
    }

    .imagen-full-screen {
        width: 100vw;
        height: 100vh;
        object-fit: cover; 
        display: block;
    }

    .seccion-composicion {
        width: 100vw;
        height: 100vh;
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
        background-color: #ffffff;
    }

    .fondo-rainbow {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: url('/rainbow.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        z-index: 1;
    }

    .contenedor-collage {
        position: relative;
        width: 90vw;
        max-width: 1400px;
        height: 80vh;
        display: flex;
        justify-content: space-between;
        align-items: center;
        z-index: 2;
    }

    .foto-izquierda {
        height: 83vh;
        width: auto;
        object-fit: contain;
        z-index: 2;
        transform: translate(9vw, 2vh); 
    }

    .foto-derecha {
        width: 60vw;
        max-width: 635px;
        height: auto;
        object-fit: contain;
        z-index: 3;
        transform: translate(-7vw, 20vh); 
    }
</style>