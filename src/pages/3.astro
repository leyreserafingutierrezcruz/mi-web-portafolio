---
import Layout from '../layouts/maestra.astro';
---

<Layout title="EXTRUIR LA DISTANCIA — Leyre Serafina Gutiérrez Cruz">
    <div class="media-luna-fondo"></div>

    <div class="scroll-container">
        <!-- ESCENA ÚNICA: Contiene la apertura inicial y el notebook que se funde y se queda fijo -->
        <section class="panel" id="escena1">
            <div class="fondo-notebook"></div>

            <div class="contenedor-imagenes-intermedias" id="contenedorIntermedias">
                <div class="grupo-imagenes-intermedias">
                    <img src="/IMG_5876.jpg" alt="IMG 5876" class="imagen-intermedia img-int-1" />
                    <img src="/IMG_5885.jpg" alt="IMG 5885" class="imagen-intermedia img-int-2" />
                </div>
            </div>

            <div class="contenedor-fondo-negro" id="zonaNegra">
                <div class="fondo-negro-zona"></div>
            </div>

            <div class="fila-inicial" id="filaImagenes">
                <img src="/IMG_5882_2.avif" alt="IMG 5882" class="imagen-base imagen-izq" />
                <img src="/IMG_5884_2.avif" alt="IMG 5884" class="imagen-base imagen-der" />
            </div>
        </section>

        <!-- ESCENA 2: Pasa directamente a la carpeta o siguiente contenido -->
        <section class="panel normal-seccion" id="escena3">
            <div class="fondo-carpet"></div>
            <div class="contenedor-imagenes-estaticas" id="contenedorEstaticas">
                <img src="/IMG_5866_2.avif" alt="IMG 5866_2" class="imagen-estatica" />
                <img src="/IMG_5868_2.avif" alt="IMG 5868_2" class="imagen-estatica" />
            </div>
        </section>
    </div>
</Layout>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);

    const tl1 = gsap.timeline({
        scrollTrigger: {
            trigger: "#escena1",
            start: "top top",
            end: "+=5500", // <--- Recorrido de scroll muy largo para que necesites varios giros de rueda completos
            pin: true,
            pinSpacing: true,
            scrub: 1 // <--- El scrub con un número (como 1) suaviza la inercia para que acompañe el movimiento del ratón con precisión
        }
    });

    // Fase 1: Apertura escalonada muy larga (muchos steps y duración amplia)
    tl1.to(".imagen-izq", { x: "-75vw", duration: 4, ease: "steps(24)" }) 
       .to(".imagen-der", { x: "75vw", duration: 4, ease: "steps(24)" }, "<")
       .to(".fondo-negro-zona", { opacity: 0.5, duration: 5, ease: "steps(10)" }, "<")
       .to("#zonaNegra", { opacity: 0, duration: 3.2, ease: "steps(6)" }, "<")
       
       // Fase 2: Pausa intermedia con las imágenes abiertas
       .to({}, { duration: 1.5 }) 

       // Fase 3: El notebook y sus imágenes interiores aparecen fundiéndose
       .to(".fondo-notebook", { opacity: 1, duration: 2.5, ease: "steps(6)" })
       .to(".contenedor-imagenes-intermedias", { opacity: 1, duration: 2.5, ease: "steps(6)" }, "<")
       
       // Fase 4: Tiempo estático final viendo el notebook antes de pasar a la siguiente escena
       .to({}, { duration: 4 }); 
</script>

<style>
    :global(html, body) { 
        margin: 0; 
        padding: 0; 
        width: 100vw; 
        overflow-x: hidden; 
        background-color: #ffffffef; 
        scrollbar-width: none; 
    }
    
    :global(html::-webkit-scrollbar, body::-webkit-scrollbar) {
        display: none;
    }
    
    .media-luna-fondo {
        position: fixed;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 155vw;
        height: 180px;
        background: linear-gradient(to bottom, 
            rgba(255, 255, 255, 1) 30%, 
            rgba(255, 255, 255, 0.85) 40%, 
            rgba(255, 255, 255, 0.4) 65%, 
            rgba(255, 255, 255, 0) 100%
        );
        filter: blur(25px);
        border-radius: 0 0 50% 50%;
        z-index: 998;
        pointer-events: none;
    }

    .scroll-container { width: 100%; }

    .panel { 
        height: 100vh; 
        width: 100vw; 
        display: flex; 
        justify-content: center; 
        align-items: center; 
        position: relative; 
        overflow: hidden; 
        background-color: #ffffff;
    }

    .normal-seccion {
        position: relative;
    }

    .fondo-carpet {
        position: absolute;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        z-index: 1;
        background-image: url('/try.png');
    }

    .fondo-notebook {
        position: absolute;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-image: url('/notebook.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        z-index: 1;
        opacity: 0; 
        transform: translateY(0px) translateX(0px) scale(1) rotate(0deg); 
    }

    .contenedor-fondo-negro {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 2050px; 
        height: 1520px; 
        z-index: 2;
        pointer-events: none;
        background-color: rgb(255, 255, 255);
    }

    .fondo-negro-zona {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: url('/black.avif');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }
    
    .fila-inicial { 
        display: flex; 
        align-items: center; 
        gap: 20px; 
        position: absolute; 
        z-index: 3; 
        left: 49.5%; 
        transform: translateX(-50%);
    }

    .imagen-base { height: 300px; width: auto; object-fit: contain; }

    .contenedor-imagenes-intermedias {
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 2; 
        opacity: 0; 
    }

    .grupo-imagenes-intermedias {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 40px; 
    }

    .imagen-intermedia {
        height: 40vh; 
        width: auto;
        object-fit: contain;
    }

    .img-int-1 { 
        transform: translateY(33px) translateX(-60px) scale(1.9) rotate(0deg); 
    } 

    .img-int-2 { 
        transform: translateY(35px) translateX(120px) scale(1.9) rotate(0deg); 
    }  

    .contenedor-imagenes-estaticas {
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        gap:20px;
        z-index: 2; 
        transform: translateX(250px);
    }

    .imagen-estatica {
        height: 300px;
        width: auto;
        object-fit: contain;
    }
</style>