---
import Layout from '../layouts/maestra.astro';
---

<Layout title="EXTRUIR LA DISTANCIA — Leyre Serafina Gutiérrez Cruz">
    <div class="media-luna-fondo"></div>

    <div class="scroll-container">
        <section class="panel" id="escena1">
            <div class="fondo-carpet"></div>

            <div class="contenedor-fondo-negro" id="zonaNegra">
                <div class="fondo-negro-zona"></div>
            </div>

            <div class="fila-inicial" id="filaImagenes">
                <img src="/IMG_5882_2.avif" alt="IMG 5882" class="imagen-base imagen-izq" />
                <img src="/IMG_5884_2.avif" alt="IMG 5884" class="imagen-base imagen-der" />
            </div>

            <div class="contenedor-imagenes-estaticas" id="contenedorEstaticas">
                <img src="/IMG_5866_2.avif" alt="IMG 5866_2" class="imagen-estatica" />
                <img src="/IMG_5868_2.avif" alt="IMG 5868_2" class="imagen-estatica" />
            </div>
        </section>

        <section class="panel" id="escena2">
            <div class="fondo-notebook"></div>

            <div class="contenedor-imagenes-finales" id="contenedorFinales">
                <div class="grupo-imagenes-finales">
                    <img src="/IMG_5909.avif" alt="IMG 5909" class="imagen-fija-final img-final-1" /> 
                    <img src="/IMG_5907.avif" alt="IMG 5907" class="imagen-fija-final img-final-2" />
                    <img src="/IMG_5885.avif" alt="IMG 5885" class="imagen-fija-final img-final-3" />
                </div>
            </div>
        </section>
    </div>
</Layout>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);

    const tl1 = gsap.timeline({
        scrollTrigger: {
            trigger: "#escena1",
            start: "top top",
            end: "+=1400", 
            pin: true,
            scrub: true
        }
    });

    tl1.to(".imagen-izq", { x: "-75vw", duration: 1, ease: "steps(18)" })
       .to(".imagen-der", { x: "75vw", duration: 1, ease: "steps(18)" }, "<")
       .to(".fondo-negro-zona", { opacity: 0, duration: 1, ease: "steps(14)" }, "<")
       .to("#zonaNegra", { opacity: 0, duration: 1.2, ease: "steps(14)" }, "<")
       .fromTo(".fondo-carpet", { opacity: 0 }, { opacity: 1, duration: 0.4, ease: "steps(4)" }, "-=0.3")
       .fromTo("#contenedorEstaticas", { opacity: 0 }, { opacity: 1, duration: 0.4, ease: "steps(4)" }, "-=0.3");
       
    tl1.to({}, { duration: 1.2 });

    const tl2 = gsap.timeline({
        scrollTrigger: {
            trigger: "#escena2",
            start: "top top",
            end: "+=200",
            pin: true,
            scrub: true
        }
    });

    tl2.fromTo("#contenedorFinales", { opacity: 0 }, { opacity: 1, duration: 0.5, ease: "steps(4)" });

    let isScrolling = false;
    window.addEventListener("wheel", (e) => {
        if (isScrolling) return;
        const scrollY = window.scrollY;
        const windowHeight = window.innerHeight;
        
        if (scrollY < windowHeight * 3) {
            e.preventDefault(); 
            isScrolling = true;
            const jumpSize = 80; 
            const direction = e.deltaY > 0 ? 1 : -1;
            window.scrollBy({ top: direction * jumpSize, behavior: "auto" });
            setTimeout(() => { isScrolling = false; }, 120); 
        }
    }, { passive: false });
</script>

<style>
    :global(html, body) { 
        margin: 0; 
        padding: 0; 
        width: 100vw; 
        overflow-x: hidden; 
        background-color: #ffffffef; 
        /* Oculta la barra de scroll vertical en Firefox */
        scrollbar-width: none; 
    }
    
    /* Oculta la barra de scroll vertical en Chrome, Safari y Edge */
    :global(html::-webkit-scrollbar, body::-webkit-scrollbar) {
        display: none;
    }
    
    .media-luna-fondo {
        position: fixed;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 155vw;
        height: 180px;
        background: linear-gradient(to bottom, 
            rgba(255, 255, 255, 1) 30%, 
            rgba(255, 255, 255, 0.85) 40%, 
            rgba(255, 255, 255, 0.4) 65%, 
            rgba(255, 255, 255, 0) 100%
        );
        filter: blur(25px);
        border-radius: 0 0 50% 50%;
        z-index: 998;
        pointer-events: none;
    }

    .scroll-container { width: 100%; }

    .panel { 
        height: 100vh; 
        width: 100vw; 
        display: flex; 
        justify-content: center; 
        align-items: center; 
        position: relative; 
        overflow: hidden; 
    }

    #escena2 { background-color: #ffffff; }

    .fondo-notebook {
        position: absolute;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-image: url('/notebook.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        z-index: 1;
    }

    .contenedor-fondo-negro {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 2050px; 
        height: 1520px; 
        z-index: 2;
        pointer-events: none;
        background-color: black;
    }

    .fondo-negro-zona {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: url('/black.avif');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }

    .fondo-carpet {
        position: absolute;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-image: url('/chalk.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        opacity: 0;
        z-index: 1; 
    }
    
    .fila-inicial { 
        display: flex; 
        align-items: center; 
        gap: 20px; 
        position: absolute; 
        z-index: 3; 
        left: 49.5%; 
        transform: translateX(-50%);
    }

    .imagen-base { height: 300px; width: auto; object-fit: contain; }

    .contenedor-imagenes-estaticas {
        position: absolute;
        top: 32vh;
        display: flex;
        justify-content: center;
        align-items: flex-end;
        gap: 130px;
        opacity: 0;
        z-index: 4;
    }

    .imagen-estatica {
        height: 350px;
        width: auto;
        object-fit: contain;
        transform: translateX(50%);
    }

    .contenedor-imagenes-finales { display: flex; justify-content: center; align-items: center; opacity: 0; z-index: 2; }
    .grupo-imagenes-finales { display: flex; justify-content: center; align-items: center; gap: 40px; }
    .imagen-fija-final { height: 40vh; width: auto; object-fit: contain; }
    .img-final-1 { height: 40vh; transform: rotate(0deg) translateX(-200px) translateY(0px) scale(1.4); }
    .img-final-2 { height: 40vh; transform: rotate(0deg) translateX(-122px) translateY(0px) scale(2.2); }
    .img-final-3 { height: 40vh; transform: rotate(0deg) translateX(-35px) translateY(0px) scale(1.5); }
</style>