---
import Layout from '../layouts/maestra.astro';
---

<Layout title="EXTRUIR LA DISTANCIA — Leyre Serafina Gutiérrez Cruz">
    <div class="media-luna-fondo"></div>

    <div class="scroll-container">
        <section class="panel" id="escena1">
            <div class="fondo-carpet"></div>

            <div class="contenedor-fondo-negro" id="zonaNegra">
                <div class="fondo-negro-zona"></div>
            </div>

            <div class="fila-inicial" id="filaImagenes">
                <img src="/IMG_5882.JPG" alt="IMG 5882" class="imagen-base imagen-izq" />
                <img src="/IMG_5884.JPG" alt="IMG 5884" class="imagen-base imagen-der" />
            </div>
 
            <div class="bloque-conjunto" id="contenedorConjunto">
                <img src="/IMG_5876.JPG" alt="IMG 5876 revelada" class="imagen-revelada" />
                <img src="/IMG_5868.JPG" alt="IMG 5868" class="imagen-principal" />
                <img src="/sombra_5868.JPG" alt="sombra 5868" class="imagen-sombra" />
            </div>
        </section>

        <section class="panel" id="escena2">
            <div class="contenedor-imagenes-finales" id="contenedorFinales">
                <div class="grupo-imagenes-finales">
                    <img src="/IMG_5909.JPG" alt="IMG 5909" class="imagen-fija-final img-final-1" /> 
                    <img src="/IMG_5907.JPG" alt="IMG 5907" class="imagen-fija-final img-final-2" />
                    <img src="/IMG_5885.JPG" alt="IMG 5885" class="imagen-fija-final img-final-3" />
                </div>
            </div>
        </section>
    </div>
</Layout>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);

    const tl1 = gsap.timeline({
        scrollTrigger: {
            trigger: "#escena1",
            start: "top top",
            end: "+=1400", 
            pin: true,
            scrub: true
        }
    });

    tl1.to(".imagen-izq", { x: "-75vw", duration: 1, ease: "steps(18)" })
       .to(".imagen-der", { x: "75vw", duration: 1, ease: "steps(18)" }, "<")
       .to(".fondo-negro-zona", { opacity: 0, duration: 1, ease: "steps(14)" }, "<")
       .to("#zonaNegra", { opacity: 0, duration: 1.2, ease: "steps(14)" }, "<")
       .fromTo(".fondo-carpet", { opacity: 0 }, { opacity: 1, duration: 0.4, ease: "steps(4)" }, "-=0.3")
       .fromTo("#contenedorConjunto", { opacity: 0 }, { opacity: 1, duration: 0.4, ease: "steps(4)" }, "-=0.3");
       
    tl1.to({}, { duration: 1.2 });

    const tl2 = gsap.timeline({
        scrollTrigger: {
            trigger: "#escena2",
            start: "top top",
            end: "+=200",
            pin: true,
            scrub: true
        }
    });

    tl2.fromTo("#contenedorFinales", { opacity: 0 }, { opacity: 1, duration: 0.5, ease: "steps(4)" });

    let isScrolling = false;
    window.addEventListener("wheel", (e) => {
        if (isScrolling) return;
        const scrollY = window.scrollY;
        const windowHeight = window.innerHeight;
        
        if (scrollY < windowHeight * 3) {
            e.preventDefault(); 
            isScrolling = true;
            const jumpSize = 80; 
            const direction = e.deltaY > 0 ? 1 : -1;
            window.scrollBy({ top: direction * jumpSize, behavior: "auto" });
            setTimeout(() => { isScrolling = false; }, 120); 
        }
    }, { passive: false });
</script>

<style>
    :global(html, body) { 
        margin: 0; 
        padding: 0; 
        width: 100vw; 
        overflow-x: hidden; 
        background-color: #ffffffef; 
    }
    
    .media-luna-fondo {
        position: fixed;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 155vw;
        height: 180px;
        background: linear-gradient(to bottom, 
            rgba(255, 255, 255, 1) 30%, 
            rgba(255, 255, 255, 0.85) 40%, 
            rgba(255, 255, 255, 0.4) 65%, 
            rgba(255, 255, 255, 0) 100%
        );
        filter: blur(25px);
        border-radius: 0 0 50% 50%;
        z-index: 998;
        pointer-events: none;
    }

    .scroll-container { width: 100%; }

    .panel { 
        height: 100vh; 
        width: 100vw; 
        display: flex; 
        justify-content: center; 
        align-items: center; 
        position: relative; 
        overflow: hidden; 
    }

    #escena2 { background-color: #ffffff; }

    .contenedor-fondo-negro {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 2050px; 
        height: 1520px; 
        z-index: 2;
        pointer-events: none;
        background-color: black;
    }

    .fondo-negro-zona {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: url('/black.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }

    .fondo-carpet {
        position: absolute;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-image: url('/carpet.png');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        opacity: 0;
        z-index: 1; 
    }
    
    .fila-inicial { 
        display: flex; 
        align-items: center; 
        gap: 20px; 
        position: absolute; 
        z-index: 3; 
        left: 49.5%; 
        transform: translateX(-50%);
    }

    .imagen-base { height: 300px; width: auto; object-fit: contain; }

    .bloque-conjunto {
        position: absolute;
        top: 35vh;
        right: 1vw; 
        display: flex;
        align-items: flex-end; 
        opacity: 0;
        z-index: 4;
        cursor: pointer;
        transform-origin: top right;
        transform: scale(1.7);
    }

    .imagen-revelada {
        position: absolute;
        left: 20px; 
        bottom: -21px;
        height: 280px;
        width: auto;
        object-fit: contain;
        opacity: 0;
        z-index: 1;
        transition: opacity 0.3s steps(4, end);
    }

    .imagen-principal { 
        height: 200px; 
        width: auto; 
        object-fit: contain; 
        position: relative;
        z-index: 3;
        transition: transform 0.3s steps(4, end);
    }

    .imagen-sombra { 
        height: 138px; 
        width: auto; 
        object-fit: contain; 
        margin-bottom: -20.6px; 
        position: relative;
        z-index: 2;
        transition: opacity 0.3s steps(4, end);
    }

    .bloque-conjunto:hover .imagen-principal { transform: translateX(-400px) translateY(-20px) scale(1.4); }
    .bloque-conjunto:hover .imagen-sombra { opacity: 0; }
    .bloque-conjunto:hover .imagen-revelada { opacity: 1; }

    .contenedor-imagenes-finales { display: flex; justify-content: center; align-items: center; opacity: 0; z-index: 2; }
    .grupo-imagenes-finales { display: flex; justify-content: center; align-items: center; gap: 40px; }
    .imagen-fija-final { height: 40vh; width: auto; object-fit: contain; }
    .img-final-1 { height: 40vh; transform: rotate(0deg) translateX(-200px) translateY(0px) scale(1.4); }
    .img-final-2 { height: 40vh; transform: rotate(0deg) translateX(-122px) translateY(0px) scale(2.2); }
    .img-final-3 { height: 40vh; transform: rotate(0deg) translateX(-35px) translateY(0px) scale(1.5); }
</style>